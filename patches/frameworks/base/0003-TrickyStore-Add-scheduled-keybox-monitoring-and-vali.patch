+    @Override
+    public void requestTrickyStoreKeyboxOperation(int operation, String payload,
+            android.os.RemoteCallback callback) {
+        mContext.enforceCallingOrSelfPermission(android.Manifest.permission.WRITE_SECURE_SETTINGS,
+                "Keybox operations require WRITE_SECURE_SETTINGS");
+        if (Binder.getCallingUid() != android.os.Process.SYSTEM_UID) {
+            throw new SecurityException("Keybox operations are restricted to system-user Settings");
+        }
+        long token = Binder.clearCallingIdentity();
+        try {
+            AxExtServiceFactory.getSpoofManager().getKeyboxMonitor().request(operation, payload, callback);
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
