+    @Test public void changedHourlyRefreshValidatesOnlyTheCandidate() throws Exception {
+        String current = xml(NOW - DAY, NOW - 1);
+        String fresh = xml(NOW - DAY, NOW + 30 * DAY);
+        int[] requests = {0, 0};
+        KeyboxOperations.Result result = KeyboxOperations.run(KeyboxMonitor.FETCH, current, null, true,
+                () -> trust, (url, limit) -> {
+                    if (url.equals(KeyboxInspector.OFFICIAL_URL)) { requests[0]++; return fresh; }
+                    assertEquals(KeyboxInspector.STATUS_URL, url); requests[1]++; return "{\"entries\":{}}";
+                }, () -> NOW, report -> fail("Hourly refresh must not inspect the current keybox"));
+        assertEquals(1, requests[0]); assertEquals(1, requests[1]);
+        assertEquals(fresh, result.candidate);
+        assertTrue(result.report.valid());
+        assertTrue(KeyboxOperations.shouldPublish(true, true, false));
+    }
