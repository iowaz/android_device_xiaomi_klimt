+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.spoof;
+
+import static org.junit.Assert.*;
+import android.security.trickystore.KeyboxMonitor;
+import com.android.internal.org.bouncycastle.asn1.x500.X500Name;
+import com.android.internal.org.bouncycastle.cert.X509v3CertificateBuilder;
+import com.android.internal.org.bouncycastle.asn1.x509.SubjectPublicKeyInfo;
+import com.android.internal.org.bouncycastle.operator.jcajce.JcaContentSignerBuilder;
+import java.math.BigInteger;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.util.Base64;
+import java.util.Date;
+import java.util.Set;
+import org.junit.Before;
+import org.junit.Test;
+
+/** Uses generated, non-production keys; never contacts a keybox or Google endpoint. */
+public class KeyboxMonitorTest {
+    private static final long NOW = 1_800_000_000_000L;
+    private static final long DAY = 86_400_000;
+    private KeyPair rootKey, rsa, ec;
+    private byte[] root;
+    private Set<String> trust;
+
+    @Before public void fixture() throws Exception {
+        KeyPairGenerator generator = KeyPairGenerator.getInstance("RSA");
+        generator.initialize(2048);
+        rootKey = generator.generateKeyPair(); rsa = generator.generateKeyPair();
+        generator = KeyPairGenerator.getInstance("EC"); generator.initialize(256);
+        ec = generator.generateKeyPair();
+        root = cert(rootKey, rootKey, "Root", "Root", 100, NOW - DAY, NOW + 365 * DAY);
+        trust = KeyboxInspector.roots("[\"" + pem("CERTIFICATE", root).replace("\n", "\\n") + "\"]");
+    }
+
+    private byte[] cert(KeyPair subject, KeyPair signer, String name, String issuer,
+            int serial, long before, long after) throws Exception {
+        return new X509v3CertificateBuilder(new X500Name("CN=" + issuer),
+                BigInteger.valueOf(serial), new Date(before), new Date(after),
+                new X500Name("CN=" + name), SubjectPublicKeyInfo.getInstance(subject.getPublic().getEncoded()))
+                .build(new JcaContentSignerBuilder("SHA256withRSA").build(signer.getPrivate())).getEncoded();
+    }
+
+    private static String pem(String type, byte[] der) {
+        return "-----BEGIN " + type + "-----\n" + Base64.getEncoder().encodeToString(der)
+                + "\n-----END " + type + "-----\n";
+    }
+
+    private String key(String algorithm, KeyPair pair, byte[]... certs) {
+        StringBuilder xml = new StringBuilder("<Key algorithm=\"" + algorithm + "\"><PrivateKey format=\"pem\">");
+        xml.append(pem("PRIVATE KEY", pair.getPrivate().getEncoded()));
+        xml.append("</PrivateKey><CertificateChain><NumberOfCertificates>").append(certs.length)
+                .append("</NumberOfCertificates>");
+        for (byte[] cert : certs) xml.append("<Certificate format=\"pem\">")
+                .append(pem("CERTIFICATE", cert)).append("</Certificate>");
+        return xml.append("</CertificateChain></Key>").toString();
+    }
+
+    private String xml(long before, long after) throws Exception {
+        return wrap(key("rsa", rsa, cert(rsa, rootKey, "RSA", "Root", 255, before, after), root)
+                + key("ecdsa", ec, root, cert(ec, rootKey, "EC", "Root", 256, before, after + DAY)));
+    }
+    private static String wrap(String keys) {
+        return "<AndroidAttestation><NumberOfKeyboxes>1</NumberOfKeyboxes><Keybox DeviceID=\"TEST_ONLY\">"
+                + keys + "</Keybox></AndroidAttestation>";
+    }
+    private KeyboxInspector.Report check(String xml, String status) throws Exception {
+        return KeyboxInspector.inspect(xml, trust, (url, limit) -> status, NOW);
+    }
+
+    @Test public void allIntervalsKeepTheirAnchorWithoutDrift() {
+        for (int minutes : new int[]{15, 30, 45, 60, 240, 720, 1440}) {
+            long period = minutes * 60_000L;
+            assertEquals(period, KeyboxSchedule.interval(minutes));
+            long due = 50_000;
+            for (int i = 0; i < 100; i++) {
+                long next = KeyboxSchedule.next(due, due + 57_000, period);
+                assertEquals(due + period, next); due = next;
+            }
