--- /dev/null
+++ b/services/core/java/com/android/server/spoof/KeyboxSchedule.java
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.spoof;
+
+/** Clock-independent scheduling and commit policy, also exercised by host tests. */
+final class KeyboxSchedule {
+    static long interval(int minutes) {
+        return android.security.trickystore.KeyboxMonitor.normalizeMinutes(minutes) * 60_000L;
+    }
+    static long afterManualCheck(long finished, long interval) {
+        return finished + interval;
+    }
+
+    /** Notify on the final outcome, using the original verdict even after replacement. */
+    static boolean shouldNotify(int mode, boolean unusable, boolean recoveryFailed) {
+        switch (android.security.trickystore.KeyboxMonitor.normalizeNotifications(mode)) {
+            case android.security.trickystore.KeyboxMonitor.NOTIFY_EVERY_CHECK: return true;
+            case android.security.trickystore.KeyboxMonitor.NOTIFY_UNUSABLE: return unusable;
+            default: return unusable && recoveryFailed;
+        }
+    }
+    static long restoreDelay(long nextWall, long nowWall, long interval) {
+        return Math.max(0, Math.min(interval, nextWall - nowWall));
+    }
+    static long next(long due, long now, long interval) {
+        if (due > now) return due;
+        return due + ((now - due) / interval + 1) * interval;
+    }
+    static boolean canCommit(boolean automatic, boolean eligible, long generation,
+            long currentGeneration, String expectedHash, String currentHash) {
+        return (!automatic || eligible && generation == currentGeneration)
+                && expectedHash.equals(currentHash);
+    }
+}
diff --git a/services/core/java/com/android/server/spoof/TrickyStoreKeyboxMonitor.java b/services/core/java/com/android/server/spoof/TrickyStoreKeyboxMonitor.java
