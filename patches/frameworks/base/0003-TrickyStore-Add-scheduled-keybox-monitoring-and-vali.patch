@@ -0,0 +1,167 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.spoof;
+
+import static org.junit.Assert.*;
+import android.security.trickystore.KeyboxMonitor;
+import com.android.internal.org.bouncycastle.asn1.x500.X500Name;
+import com.android.internal.org.bouncycastle.cert.X509v3CertificateBuilder;
+import com.android.internal.org.bouncycastle.asn1.x509.SubjectPublicKeyInfo;
+import com.android.internal.org.bouncycastle.operator.jcajce.JcaContentSignerBuilder;
+import java.math.BigInteger;
+import java.security.KeyPair;
+import java.security.KeyPairGenerator;
+import java.util.Base64;
+import java.util.Date;
+import java.util.Set;
+import org.junit.Before;
+import org.junit.Test;
+
+/** Uses generated, non-production keys; never contacts a keybox or Google endpoint. */
+public class KeyboxMonitorTest {
+    private static final long NOW = 1_800_000_000_000L;
+    private static final long DAY = 86_400_000;
+    private KeyPair rootKey, rsa, ec;
+    private byte[] root;
+    private Set<String> trust;
+
+    @Before public void fixture() throws Exception {
+        KeyPairGenerator generator = KeyPairGenerator.getInstance("RSA");
+        generator.initialize(2048);
+        rootKey = generator.generateKeyPair(); rsa = generator.generateKeyPair();
+        generator = KeyPairGenerator.getInstance("EC"); generator.initialize(256);
+        ec = generator.generateKeyPair();
+        root = cert(rootKey, rootKey, "Root", "Root", 100, NOW - DAY, NOW + 365 * DAY);
+        trust = KeyboxInspector.roots("[\"" + pem("CERTIFICATE", root).replace("\n", "\\n") + "\"]");
+    }
+
+    private byte[] cert(KeyPair subject, KeyPair signer, String name, String issuer,
+            int serial, long before, long after) throws Exception {
+        return new X509v3CertificateBuilder(new X500Name("CN=" + issuer),
+                BigInteger.valueOf(serial), new Date(before), new Date(after),
+                new X500Name("CN=" + name), SubjectPublicKeyInfo.getInstance(subject.getPublic().getEncoded()))
+                .build(new JcaContentSignerBuilder("SHA256withRSA").build(signer.getPrivate())).getEncoded();
+    }
+
+    private static String pem(String type, byte[] der) {
+        return "-----BEGIN " + type + "-----\n" + Base64.getEncoder().encodeToString(der)
+                + "\n-----END " + type + "-----\n";
+    }
+
+    private String key(String algorithm, KeyPair pair, byte[]... certs) {
+        StringBuilder xml = new StringBuilder("<Key algorithm=\"" + algorithm + "\"><PrivateKey format=\"pem\">");
+        xml.append(pem("PRIVATE KEY", pair.getPrivate().getEncoded()));
+        xml.append("</PrivateKey><CertificateChain><NumberOfCertificates>").append(certs.length)
+                .append("</NumberOfCertificates>");
+        for (byte[] cert : certs) xml.append("<Certificate format=\"pem\">")
+                .append(pem("CERTIFICATE", cert)).append("</Certificate>");
+        return xml.append("</CertificateChain></Key>").toString();
+    }
+
+    private String xml(long before, long after) throws Exception {
+        return wrap(key("rsa", rsa, cert(rsa, rootKey, "RSA", "Root", 255, before, after), root)
+                + key("ecdsa", ec, root, cert(ec, rootKey, "EC", "Root", 256, before, after + DAY)));
+    }
+    private static String wrap(String keys) {
+        return "<AndroidAttestation><NumberOfKeyboxes>1</NumberOfKeyboxes><Keybox DeviceID=\"TEST_ONLY\">"
+                + keys + "</Keybox></AndroidAttestation>";
+    }
+    private KeyboxInspector.Report check(String xml, String status) throws Exception {
+        return KeyboxInspector.inspect(xml, trust, (url, limit) -> status, NOW);
+    }
+
+    @Test public void allIntervalsKeepTheirAnchorWithoutDrift() {
+        for (int minutes : new int[]{15, 30, 45, 60, 120, 720}) {
+            long period = minutes * 60_000L;
+            assertEquals(period, KeyboxSchedule.interval(minutes));
+            long due = 50_000;
+            for (int i = 0; i < 100; i++) {
+                long next = KeyboxSchedule.next(due, due + 57_000, period);
+                assertEquals(due + period, next); due = next;
+            }
+        }
+        assertEquals(3_600_000L, KeyboxSchedule.interval(0));
+    }
+    @Test public void missedTicksRunOnceThenResumeFutureAnchor() {
+        assertEquals(4_600_000L, KeyboxSchedule.next(100_000, 4_000_000, 900_000));
+        assertEquals(100_000, KeyboxSchedule.next(100_000, 99_000, 900_000));
+    }
+    @Test public void rebootAndClockChangesClampDelay() {
+        assertEquals(0, KeyboxSchedule.restoreDelay(1_000, 2_000, 900_000));
+        assertEquals(900_000, KeyboxSchedule.restoreDelay(9_000_000, 2_000, 900_000));
+        assertEquals(500, KeyboxSchedule.restoreDelay(2_500, 2_000, 900_000));
+    }
+    @Test public void disableImportAndGenerationChangesPreventLateCommit() {
+        assertTrue(KeyboxSchedule.canCommit(true, true, 7, 7, "A", "A"));
+        assertFalse(KeyboxSchedule.canCommit(true, false, 7, 7, "A", "A"));
+        assertFalse(KeyboxSchedule.canCommit(true, true, 7, 8, "A", "A"));
+        assertFalse(KeyboxSchedule.canCommit(true, true, 7, 7, "A", "B"));
+        assertTrue(KeyboxSchedule.canCommit(false, false, 7, 8, "A", "A"));
+        assertFalse(KeyboxSchedule.canCommit(false, false, 7, 8, "A", "B"));
+    }
+    @Test public void bothAlgorithmsAndUnorderedChainAreValid() throws Exception {
+        KeyboxInspector.Report result = check(xml(NOW - DAY, NOW + 30 * DAY), "{\"entries\":{}}");
+        assertEquals(KeyboxInspector.Status.VALID, result.status);
+        assertEquals(NOW + 30 * DAY, result.expiry);
+    }
+    @Test public void expiryAndWarningHaveDistinctResults() throws Exception {
+        assertEquals(KeyboxInspector.Status.EXPIRED, check(xml(NOW - DAY, NOW), "").status);
+        assertEquals(KeyboxInspector.Status.EXPIRING_SOON,
+                check(xml(NOW - DAY, NOW + 7 * DAY), "{\"entries\":{}}").status);
+        assertEquals(KeyboxInspector.Status.CHAIN_INVALID,
+                check(xml(NOW + DAY, NOW + 30 * DAY), "{\"entries\":{}}").status);
+    }
+    @Test public void checksEveryChainAndBothSerialSpellings() throws Exception {
+        String xml = xml(NOW - DAY, NOW + 30 * DAY);
+        for (String serial : new String[]{"ff", "255", "100", "256", "64"}) {
+            assertEquals(serial, KeyboxInspector.Status.REVOKED, check(xml,
+                    "{\"entries\":{\"" + serial + "\":{\"status\":\"REVOKED\",\"reason\":\"KEY_COMPROMISE\"}}}").status);
+        }
+        assertEquals(KeyboxInspector.Status.SUSPENDED, check(xml,
+                "{\"entries\":{\"ff\":{\"status\":\"SUSPENDED\"}}}").status);
+    }
+    @Test public void unavailableMalformedAndChangedStatusNeverMeanValid() throws Exception {
+        String xml = xml(NOW - DAY, NOW + 30 * DAY);
+        for (String body : new String[]{"", "<html>error</html>", "{}", "{\"entries\":[]}",
+                "{\"entries\":{\"ff\":\"broken\"}}",
+                "{\"entries\":{\"ff\":{\"status\":\"SOMETHING_NEW\"}}}"}) {
+            assertEquals(KeyboxInspector.Status.UNKNOWN, check(xml, body).status);
+        }
+        assertEquals(KeyboxInspector.Status.UNKNOWN, KeyboxInspector.inspect(xml, trust,
+                (url, limit) -> { throw new java.io.IOException("offline"); }, NOW).status);
+    }
+    @Test public void untrustedAndMismatchedKeysAreRejected() throws Exception {
+        String xml = xml(NOW - DAY, NOW + 30 * DAY);
+        assertEquals(KeyboxInspector.Status.UNTRUSTED_ROOT, KeyboxInspector.inspect(xml,
+                Set.of("wrong root"), (url, limit) -> "{\"entries\":{}}", NOW).status);
+        assertEquals(KeyboxInspector.Status.CHAIN_INVALID, check(wrap(key("rsa", rootKey,
+                cert(rsa, rootKey, "RSA", "Root", 255, NOW - DAY, NOW + 30 * DAY), root)), "").status);
+        assertEquals(KeyboxInspector.Status.CHAIN_INVALID, check("<AndroidAttestation>", "").status);
+    }
+    @Test public void reportsStayBoundToContentRatherThanEncoding() throws Exception {
+        String xml = xml(NOW - DAY, NOW + 30 * DAY);
+        assertEquals(KeyboxMonitor.keyboxHash(xml), KeyboxMonitor.keyboxHash(
+                Base64.getEncoder().encodeToString(xml.getBytes(java.nio.charset.StandardCharsets.UTF_8))));
+        assertNotEquals(KeyboxMonitor.keyboxHash("broken A"), KeyboxMonitor.keyboxHash("broken B"));
+    }
+    @Test public void recoveryRequiresPositiveValidation() {
+        for (KeyboxInspector.Status status : KeyboxInspector.Status.values()) {
+            KeyboxInspector.Report report = new KeyboxInspector.Report(status, "", 0);
+            assertEquals(status == KeyboxInspector.Status.VALID
+                    || status == KeyboxInspector.Status.EXPIRING_SOON, report.valid());
+            assertEquals(status == KeyboxInspector.Status.EXPIRED
+                    || status == KeyboxInspector.Status.REVOKED
+                    || status == KeyboxInspector.Status.SUSPENDED, report.recoverable());
+        }
+    }
+    @Test public void intermediateExpiryIsNotHiddenByValidLeaf() throws Exception {
+        byte[] intermediate = cert(rsa, rootKey, "Intermediate", "Root", 500,
+                NOW - 10 * DAY, NOW - DAY);
+        byte[] leaf = cert(ec, rsa, "EC", "Intermediate", 501, NOW - DAY, NOW + 30 * DAY);
+        assertEquals(KeyboxInspector.Status.EXPIRED,
+                check(wrap(key("ecdsa", ec, leaf, intermediate, root)), "{\"entries\":{}}").status);
+    }
+    @Test public void missingAndMalformedEncodingAreDifferent() throws Exception {
+        assertEquals(KeyboxInspector.Status.MISSING, check("", "").status);
+        assertEquals(KeyboxInspector.Status.CHAIN_INVALID, check("not a keybox", "").status);
+    }
+}
