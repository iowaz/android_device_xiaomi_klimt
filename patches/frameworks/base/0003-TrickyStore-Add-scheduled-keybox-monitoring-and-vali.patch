diff --git a/core/java/android/security/trickystore/KeyboxMonitor.java b/core/java/android/security/trickystore/KeyboxMonitor.java
new file mode 100644
index 0000000000000000000000000000000000000000..e4b7e73cc720d96ba8b84a9814fe3da9ae250972
--- /dev/null
+++ b/core/java/android/security/trickystore/KeyboxMonitor.java
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package android.security.trickystore;
+
+import android.app.ActivityManager;
+import android.os.RemoteCallback;
+import android.os.RemoteException;
+
+/**
+ * Shared contract for Settings and the system-owned keybox monitor.
+ * @hide
+ */
+public final class KeyboxMonitor {
+    private KeyboxMonitor() {}
+    public static final String ENABLED = "spoof_trickystore_monitor_enabled";
+    public static final String INTERVAL = "spoof_trickystore_monitor_minutes";
+    public static final String NOTIFICATIONS = "spoof_trickystore_monitor_notifications";
+    public static final int NOTIFY_EVERY_CHECK = 0;
+    public static final int NOTIFY_UNUSABLE = 1;
+    public static final int NOTIFY_RECOVERY_FAILED = 2;
+    public static final int DEFAULT_NOTIFICATIONS = NOTIFY_RECOVERY_FAILED;
+    public static final int DEFAULT_MINUTES = 60;
+    public static final int MAX_PAYLOAD_BYTES = 256 * 1024;
+
+    /** One interval contract for Settings, the resume check and the background timer. */
+    public static java.util.List<Integer> intervalMinutes() {
+        return java.util.List.of(15, 30, 45, 60, 240, 720, 1440);
+    }
+
+    public static int normalizeMinutes(int minutes) {
+        // The first local release offered two hours; migrate that choice to four hours.
+        if (minutes == 120) return 240;
+        return intervalMinutes().contains(minutes) ? minutes : DEFAULT_MINUTES;
+    }
+
+    public static int normalizeNotifications(int mode) {
+        return mode >= NOTIFY_EVERY_CHECK && mode <= NOTIFY_RECOVERY_FAILED
+                ? mode : DEFAULT_NOTIFICATIONS;
+    }
+
+    public static final String NEXT = "spoof_trickystore_monitor_next";
+    public static final String REPORT = "spoof_trickystore_monitor_report";
+    public static final String KEYBOX = "spoof_trickystore_keybox";
+    public static final String SOURCE = "spoof_trickystore_keybox_source";
+    public static final int CHECK = 0;
+    public static final int FETCH = 1;
+    public static final int IMPORT = 2;
+    public static final int DELETE = 3;
+
+    public static String keyboxHash(String raw) {
+        try {
+            String xml = TrickyStoreService.decodeKeybox(raw == null ? "" : raw);
+            String content = xml == null ? (raw == null ? "" : raw) : xml.trim();
+            byte[] digest = java.security.MessageDigest.getInstance("SHA-256").digest(
+                    content.getBytes(java.nio.charset.StandardCharsets.UTF_8));
+            StringBuilder out = new StringBuilder();
+            for (byte b : digest) out.append(String.format(java.util.Locale.ROOT, "%02X", b));
+            return out.toString();
+        } catch (java.security.NoSuchAlgorithmException e) { throw new AssertionError(e); }
+    }
+
+    public static void request(int operation, String payload, RemoteCallback callback)
+            throws RemoteException {
+        ActivityManager.getService().requestTrickyStoreKeyboxOperation(operation, payload, callback);
+    }
+}
