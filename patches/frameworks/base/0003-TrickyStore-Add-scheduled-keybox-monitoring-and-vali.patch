index 0000000000000000000000000000000000000000..d1360820f815c194d8e7d86284e03fee5ae600f4
--- /dev/null
+++ b/services/core/java/com/android/server/spoof/TrickyStoreKeyboxMonitor.java
@@ -0,0 +1,645 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.spoof;
+
+import static android.security.trickystore.KeyboxMonitor.CHECK;
+import static android.security.trickystore.KeyboxMonitor.FETCH;
+import static android.security.trickystore.KeyboxMonitor.IMPORT;
+import static android.security.trickystore.KeyboxMonitor.DELETE;
+import static android.security.trickystore.KeyboxMonitor.ENABLED;
+import static android.security.trickystore.KeyboxMonitor.INTERVAL;
+import static android.security.trickystore.KeyboxMonitor.KEYBOX;
+import static android.security.trickystore.KeyboxMonitor.SOURCE;
+import static android.security.trickystore.KeyboxMonitor.NEXT;
+import static android.security.trickystore.KeyboxMonitor.REPORT;
+import static android.security.trickystore.KeyboxMonitor.NOTIFICATIONS;
+import static android.security.trickystore.KeyboxMonitor.DEFAULT_NOTIFICATIONS;
+import static android.security.trickystore.KeyboxMonitor.DEFAULT_MINUTES;
+import static android.security.trickystore.KeyboxMonitor.normalizeMinutes;
+import android.app.AlarmManager;
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.BroadcastReceiver;
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.database.ContentObserver;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.PowerManager;
+import android.os.RemoteCallback;
+import android.os.SystemClock;
+import android.os.UserHandle;
+import android.os.UserManager;
+import android.provider.Settings;
+import android.security.trickystore.KeyBoxManager;
+import android.security.trickystore.TrickyStoreService;
+import android.system.Os;
+import android.util.AtomicFile;
+import android.util.Base64;
+import android.util.Slog;
+import com.android.internal.R;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.Set;
+import java.util.concurrent.Future;
+import java.util.concurrent.SynchronousQueue;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.function.BooleanSupplier;
+import org.json.JSONObject;
+
+/** System-user keybox operations. All state and commits are owned by mHandler. */
+public final class TrickyStoreKeyboxMonitor {
+    private static final String TAG = "TrickyStoreKeyboxMonitor";
+    private static final String TS_ENABLED = "spoof_trickystore_enabled";
+    private static final String RKP_ENABLED = "spoof_duck_rkp_enabled";
+    private static final String ACTIVATED = "spoof_activated";
+    private static final String LAST_FETCHED = "spoof_trickystore_last_fetched";
+    private static final String LAST_CHECK = "spoof_trickystore_last_revocation_check";
+    private static final String LAST_STATUS = "spoof_trickystore_last_revocation_status";
+    private static final String LAST_REASON = "spoof_trickystore_last_revocation_reason";
+    private static final String FAILED_FETCH = "spoof_trickystore_last_no_valid";
+    private static final String QUIET_CHANNEL = "trickystore_monitor_results";
+    private static final String ALERT_CHANNEL = "trickystore_monitor_recovery";
+    private static final int QUIET_ID = 0x7b0e;
+    private static final int ALERT_ID = 0x7b0f;
+    private static final long DEADLINE = 60_000;
+
+    private final Context mContext;
+    private final ContentResolver mResolver;
+    private final Handler mHandler;
+    private final BooleanSupplier mActivated;
+    private final BooleanSupplier mReload;
+    private final AlarmManager mAlarms;
+    // At most one transaction is current. A second thread lets a new transaction run if
+    // the previous one timed out in uninterruptible DNS; a third is rejected, not leaked.
+    private final ThreadPoolExecutor mWorkers = new ThreadPoolExecutor(0, 2, 30,
+            TimeUnit.SECONDS, new SynchronousQueue<>());
+    // TLS disconnect can block too; never consume the spare validation worker with it.
+    private final ThreadPoolExecutor mDisconnects = new ThreadPoolExecutor(0, 1, 30,
+            TimeUnit.SECONDS, new SynchronousQueue<>());
+    private final ArrayDeque<Request> mRequests = new ArrayDeque<>();
+    private final AlarmManager.OnAlarmListener mAlarm = this::onAlarm;
+    private boolean mLoaded;
+    private boolean mEnabled;
+    private boolean mEligible;
+    private long mInterval;
+    private long mDue;
+    private long mGeneration;
+    private Cycle mCurrent;
+
+    public TrickyStoreKeyboxMonitor(Context context,
+            BooleanSupplier activated, BooleanSupplier reload) {
+        mContext = context;
+        mResolver = context.getContentResolver();
+        HandlerThread thread = new HandlerThread(TAG);
+        thread.start();
+        mHandler = new Handler(thread.getLooper());
+        mActivated = activated; mReload = reload;
+        mAlarms = context.getSystemService(AlarmManager.class);
+    }
+
+    public void start() {
+        ContentObserver observer = new ContentObserver(mHandler) {
+            @Override public void onChange(boolean selfChange, Uri uri) { sync(); }
+        };
+        for (String key : new String[]{ENABLED, INTERVAL, KEYBOX, SOURCE, RKP_ENABLED, ACTIVATED}) {
+            mResolver.registerContentObserver(Settings.Secure.getUriFor(key), false,
+                    observer, UserHandle.USER_SYSTEM);
+        }
+        mResolver.registerContentObserver(Settings.System.getUriFor(TS_ENABLED), false,
+                observer, UserHandle.USER_SYSTEM);
+        IntentFilter filter = new IntentFilter(Intent.ACTION_USER_UNLOCKED);
+        filter.addAction(Intent.ACTION_TIME_CHANGED);
+        mContext.registerReceiver(new BroadcastReceiver() {
+            @Override public void onReceive(Context context, Intent intent) {
+                if (Intent.ACTION_TIME_CHANGED.equals(intent.getAction()) && mEligible) {
+                    putLong(NEXT, System.currentTimeMillis() + Math.max(0, mDue - SystemClock.elapsedRealtime()));
+                } else { sync(); }
+            }
+        }, filter, null, mHandler);
+        mHandler.post(() -> sync());
+    }
+
+    private boolean enabled() { return getInt(ENABLED, 0) == 1; }
+    private boolean eligible() {
+        return enabled() && mActivated.getAsBoolean()
+                && mContext.getSystemService(UserManager.class).isUserUnlocked(UserHandle.SYSTEM)
+                && Settings.System.getIntForUser(mResolver, TS_ENABLED, 1, UserHandle.USER_SYSTEM) != 0
+                && getInt(RKP_ENABLED, 0) == 0 && !raw().isEmpty();
+    }
+
+    private void sync() {
+        boolean enabled = enabled();
+        boolean eligible = eligible();
+        int configured = getInt(INTERVAL, DEFAULT_MINUTES);
+        int minutes = normalizeMinutes(configured);
+        if (configured != minutes) putLong(INTERVAL, minutes);
+        long interval = KeyboxSchedule.interval(minutes);
+        boolean changed = !mLoaded || enabled != mEnabled || interval != mInterval
+                || eligible != mEligible;
+        if (!changed) return;
+        if (mLoaded) mGeneration++;
+        mRequests.removeIf(request -> request.automatic);
+        if (mCurrent != null && mCurrent.request.automatic) cancelCurrent();
+        mAlarms.cancel(mAlarm);
+        if (!enabled) putLong(NEXT, 0);
+        if (eligible) {
+            long delay;
+            if (!mLoaded) {
+                delay = KeyboxSchedule.restoreDelay(getLong(NEXT, 0),
+                        System.currentTimeMillis(), interval);
+            } else if (mEnabled && mEligible && interval != mInterval) {
+                delay = interval;
+            } else {
+                delay = KeyboxSchedule.restoreDelay(getLong(NEXT, 0),
+                        System.currentTimeMillis(), interval);
+            }
+            mDue = SystemClock.elapsedRealtime() + delay;
+        }
+        mLoaded = true; mEnabled = enabled; mEligible = eligible; mInterval = interval;
+        if (eligible) arm();
+        drain();
+    }
+
+    private void arm() {
+        putLong(NEXT, System.currentTimeMillis() + Math.max(0, mDue - SystemClock.elapsedRealtime()));
+        // system UID exact alarms without a WorkSource receive the unrestricted idle flag.
+        mAlarms.setExact(AlarmManager.ELAPSED_REALTIME_WAKEUP, mDue, TAG, mAlarm, mHandler);
+    }
+
+    private void onAlarm() {
+        if (!eligible()) { sync(); return; }
+        mDue = KeyboxSchedule.next(mDue, SystemClock.elapsedRealtime(), mInterval);
+        arm();
+        enqueue(new Request(CHECK, null, null, true, false));
+    }
+
+    public void request(int operation, String payload, RemoteCallback callback) {
+        if (operation < CHECK || operation > DELETE) throw new IllegalArgumentException("operation");
+        if (payload != null && payload.length() > KeyboxInspector.MAX_KEYBOX) {
+            throw new IllegalArgumentException("Keybox too large");
+        }
+        mHandler.post(() -> {
+            if (operation == IMPORT || operation == DELETE) {
+                mGeneration++;
+                mRequests.removeIf(pending -> pending.automatic);
+                if (mCurrent != null && mCurrent.request.automatic) cancelCurrent();
+            }
+            enqueue(new Request(operation, payload, callback, false, false));
+        });
+    }
+
+    /** Replaces the old hourly writer. The selected monitor schedule takes precedence. */
+    public void refreshOfficialIfUnmanaged() {
+        mHandler.post(() -> {
+            if (KeyboxOperations.hourlyAllowed(enabled(), get(SOURCE)) && getInt(RKP_ENABLED, 0) == 0
+                    && mActivated.getAsBoolean()
+                    && Settings.System.getIntForUser(mResolver, TS_ENABLED, 1, UserHandle.USER_SYSTEM) != 0) {
+                enqueue(new Request(FETCH, null, null, false, true));
+            }
+        });
+    }
+
+    private void enqueue(Request request) {
+        if (request.automatic && (!eligible()
+                || mRequests.stream().anyMatch(pending -> pending.automatic))) return;
+        if (mRequests.size() >= 8) { reply(request, error("BUSY")); return; }
+        mRequests.add(request);
+        drain();
+    }
+
+    private void drain() {
+        if (mCurrent != null || mRequests.isEmpty()) return;
+        Request request = mRequests.remove();
+        if (request.automatic && !eligible()) { drain(); return; }
+        if (request.hourly && !KeyboxOperations.hourlyAllowed(enabled(), get(SOURCE))) { drain(); return; }
+        if (getInt(RKP_ENABLED, 0) != 0 || !mActivated.getAsBoolean()
+                || Settings.System.getIntForUser(mResolver, TS_ENABLED, 1, UserHandle.USER_SYSTEM) == 0) {
+            reply(request, error("DISABLED")); drain(); return;
+        }
+        if (request.operation == DELETE) {
+            String before = raw();
+            String source = get(SOURCE);
+            long fetched = getLong(LAST_FETCHED, 0);
+            Bundle result;
+            try {
+                put(KEYBOX, "");
+                put(SOURCE, "");
+                putLong(LAST_FETCHED, 0);
+                put(REPORT, "");
+                put(LAST_STATUS, "");
+                put(LAST_REASON, "");
+                putLong(LAST_CHECK, 0);
+                putLong(FAILED_FETCH, 0);
+                result = new Bundle();
+                result.putBoolean("success", true);
+            } catch (RuntimeException e) {
+                try { put(KEYBOX, before); put(SOURCE, source); putLong(LAST_FETCHED, fetched); }
+                catch (RuntimeException ignored) { Slog.e(TAG, "Unable to restore failed deletion"); }
+                result = error("STATE_WRITE_FAILED");
+            }
+            reply(request, result);
+            // Follow-on work is outside the deletion rollback transaction.
+            try { sync(); }
+            catch (RuntimeException e) { Slog.e(TAG, "Unable to resync after keybox deletion"); }
+            finally { drain(); }
+            return;
+        }
+        Cycle cycle = new Cycle(request, raw(), mGeneration);
+        mCurrent = cycle;
+        cycle.wakeLock.acquire(DEADLINE + 5_000);
+        mHandler.postDelayed(cycle.timeout, DEADLINE);
+        try { cycle.future = mWorkers.submit(() -> work(cycle)); }
+        catch (RuntimeException e) { finish(cycle, null, null, "WORKER_BUSY"); }
+    }
+
+    private void work(Cycle cycle) {
+        try {
+            KeyboxOperations.Result result = KeyboxOperations.run(cycle.request.operation,
+                    cycle.before, cycle.request.payload, cycle.request.hourly,
+                    () -> loadRoots(cycle), cycle, System::currentTimeMillis,
+                    observed -> cycle.observed = observed);
+            mHandler.post(() -> finish(cycle, result.candidate, result.report, result.failure));
+        } catch (Exception e) {
+            // Do not put URL contents, private keys or arbitrary server responses in logs/results.
+            mHandler.post(() -> finish(cycle, null, null,
+                    cycle.cancelled ? "CANCELLED" : "NETWORK_OR_VALIDATION_FAILED"));
+        }
+    }
+
+    private Set<String> loadRoots(Cycle cycle) throws Exception {
+        String cached = get(KeyboxInspector.ROOTS_CACHE);
+        long age = System.currentTimeMillis() - getLong(KeyboxInspector.ROOTS_AT, 0);
+        if (!cached.isEmpty() && age >= 0 && age <= KeyboxInspector.ROOTS_TTL) {
+            try { return KeyboxInspector.roots(cached); } catch (Exception ignored) { }
+        }
+        try {
+            String live = cycle.get(KeyboxInspector.ROOTS_URL, 256 * 1024);
+            Set<String> roots = KeyboxInspector.roots(live);
+            mHandler.post(() -> {
+                if (mCurrent == cycle && !cycle.cancelled) {
+                    put(KeyboxInspector.ROOTS_CACHE, live);
+                    putLong(KeyboxInspector.ROOTS_AT, System.currentTimeMillis());
+                }
+            });
+            return roots;
+        } catch (Exception unavailable) {
+            try { return KeyboxInspector.roots(cached); }
+            catch (Exception ignored) { return Set.of(); }
+        }
+    }
+
+    private void finish(Cycle cycle, String candidate, KeyboxInspector.Report report, String failure) {
+        try { finishInternal(cycle, candidate, report, failure); }
+        catch (RuntimeException e) {
+            // A provider/callback failure must never escape onto a system-server Handler.
+            Slog.e(TAG, "Keybox transaction could not finish");
+            if (mCurrent != cycle) {
+                // A completed request must never receive a second callback, but a
+                // failed resync after replying must not strand the remaining queue.
+                if (mCurrent == null) drain();
+                return;
+            }
+            end(cycle);
+            reply(cycle.request, error("STATE_WRITE_FAILED"));
+            drain();
+        }
+    }
+
+    private void finishInternal(Cycle cycle, String candidate, KeyboxInspector.Report report, String failure) {
+        if (mCurrent != cycle || cycle.cancelled) return;
+        if (cycle.request.hourly && !KeyboxOperations.hourlyAllowed(enabled(), get(SOURCE))
+                || !mActivated.getAsBoolean() || getInt(RKP_ENABLED, 0) != 0
+                || Settings.System.getIntForUser(mResolver, TS_ENABLED, 1, UserHandle.USER_SYSTEM) == 0
+                || !KeyboxSchedule.canCommit(cycle.request.automatic, eligible(), cycle.generation,
+                mGeneration, cycle.hash, KeyboxInspector.hash(raw()))) {
+            end(cycle); reply(cycle.request, error("STATE_CHANGED")); drain(); return;
+        }
+        String recovery = "";
+        if (report == null) report = cycle.observed;
+        if (candidate != null) {
+            String oldSource = get(SOURCE);
+            long oldFetched = getLong(LAST_FETCHED, 0);
+            boolean installed = false;
+            try {
+                if (!cycle.before.isEmpty()) backup(cycle.before);
+                String encoded = Base64.encodeToString(candidate.getBytes(StandardCharsets.UTF_8), Base64.NO_WRAP);
+                put(KEYBOX, encoded);
+                installed = true;
+                put(SOURCE, cycle.request.operation == IMPORT ? "user" : "official");
+                putLong(LAST_FETCHED, System.currentTimeMillis()); putLong(FAILED_FETCH, 0);
+                recovery = "replaced";
+                if (!mReload.getAsBoolean()) {
+                    failure = "ACTIVATION_FAILED";
+                    recovery = "reload_incomplete";
+                }
+            } catch (Exception e) {
+                if (installed) {
+                    try { put(KEYBOX, cycle.before); put(SOURCE, oldSource); putLong(LAST_FETCHED, oldFetched); }
+                    catch (RuntimeException ignored) { Slog.e(TAG, "Unable to roll back failed keybox install"); }
+                }
+                report = cycle.request.operation == IMPORT ? null : cycle.observed;
+                failure = "BACKUP_OR_INSTALL_FAILED"; recovery = "failed";
+            }
+        } else if (!failure.isEmpty() && !failure.equals("UNCHANGED")) {
+            recovery = "failed";
+        }
+        if (cycle.request.operation == FETCH && !failure.isEmpty() && !failure.equals("UNCHANGED")) {
+            putLong(FAILED_FETCH, System.currentTimeMillis());
+        }
+        // Invalid imports, saturated workers and unchanged/failed legacy refreshes did
+        // not inspect the installed keybox. Preserve its last verdict and deadline.
+        if (!KeyboxOperations.shouldPublish(cycle.request.hourly, candidate != null
+                && (recovery.equals("replaced") || recovery.equals("reload_incomplete")),
+                cycle.observed != null)) {
+            Bundle result = error(failure);
+            result.putBoolean("success", failure.isEmpty() || failure.equals("UNCHANGED"));
+            end(cycle);
+            reply(cycle.request, result);
+            drain();
+            return;
+        }
+        if (report == null) report = new KeyboxInspector.Report(
+                KeyboxInspector.Status.UNKNOWN, failure, 0);
+        // A manual status check establishes a new interval anchor, including offline checks.
+        // Remove pending automatic work so it cannot immediately repeat the user's check.
+        if ((cycle.request.operation == CHECK || cycle.request.operation == IMPORT)
+                && !cycle.request.automatic && eligible()) {
+            mRequests.removeIf(pending -> pending.automatic);
+            mDue = KeyboxSchedule.afterManualCheck(SystemClock.elapsedRealtime(), mInterval);
+            arm();
+        }
+        Bundle result = publish(cycle, report, recovery, failure);
+        result.putBoolean("success", failure.isEmpty() || failure.equals("UNCHANGED"));
+        end(cycle); reply(cycle.request, result); sync(); drain();
+    }
+
+    private Bundle publish(Cycle cycle, KeyboxInspector.Report report, String recovery, String failure) {
+        long now = System.currentTimeMillis();
+        String hash = KeyboxInspector.hash(raw());
+        JSONObject previous;
+        try { previous = new JSONObject(get(REPORT)); } catch (Exception e) { previous = new JSONObject(); }
+        JSONObject saved = new JSONObject();
+        try {
+            saved.put("hash", hash).put("status", report.status.name()).put("reason", report.reason)
+                    .put("checkedAt", now).put("expiry", report.expiry)
+                    .put("recovery", recovery).put("failure", failure);
+            if (report.status != KeyboxInspector.Status.UNKNOWN) {
+                saved.put("confirmedStatus", report.status.name()).put("confirmedAt", now);
+            } else if (hash.equals(previous.optString("hash"))) {
+                saved.put("confirmedStatus", previous.optString("confirmedStatus"))
+                        .put("confirmedAt", previous.optLong("confirmedAt"));
+            }
+        } catch (Exception e) { Slog.w(TAG, "Cannot encode keybox report"); }
+        put(REPORT, saved.toString());
+        put(LAST_STATUS, report.status.name()); put(LAST_REASON, report.reason); putLong(LAST_CHECK, now);
+        Bundle result = new Bundle();
+        result.putString("status", report.status.name()); result.putString("reason", report.reason);
+        result.putString("recovery", recovery); result.putString("failure", failure);
+        result.putLong("expiry", report.expiry); result.putLong("checkedAt", now);
+        boolean unusable = cycle.observed != null && cycle.observed.recoverable();
+        boolean finalCheck = cycle.request.operation == CHECK;
+        if (finalCheck && enabled() && KeyboxSchedule.shouldNotify(
+                getInt(NOTIFICATIONS, DEFAULT_NOTIFICATIONS), unusable, recovery.equals("failed") || recovery.equals("reload_incomplete"))) {
+            notifyResult(report, cycle.observed, recovery, saved);
+        }
+        return result;
+    }
+
+    private void backup(String before) throws Exception {
+        File directory = new File("/data/system/trickystore");
+        if (!directory.isDirectory() && !directory.mkdirs()) throw new IllegalStateException("backup directory");
+        Os.chmod(directory.getPath(), 0700);
+        AtomicFile file = new AtomicFile(new File(directory, "keybox-recovery-backup.json"));
+        JSONObject data = new JSONObject().put("payload", before).put("source", get(SOURCE))
+                .put("fetchedAt", getLong(LAST_FETCHED, 0)).put("savedAt", System.currentTimeMillis());
+        FileOutputStream stream = null;
+        try {
+            stream = file.startWrite();
+            Os.fchmod(stream.getFD(), 0600);
+            stream.write(data.toString().getBytes(StandardCharsets.UTF_8));
+            file.finishWrite(stream);
+        } catch (Exception e) { if (stream != null) file.failWrite(stream); throw e; }
+    }
+
+    private void cancelCurrent() {
+        Cycle cycle = mCurrent;
+        if (cycle == null) return;
+        cycle.cancelled = true;
+        if (cycle.future != null) cycle.future.cancel(true);
+        end(cycle);
+    }
+
+    private void end(Cycle cycle) {
+        mHandler.removeCallbacks(cycle.timeout);
+        if (cycle.wakeLock.isHeld()) cycle.wakeLock.release();
+        if (mCurrent == cycle) mCurrent = null;
+        // Disconnect away from the Handler: implementations can block while closing TLS.
+        if (cycle.hasConnections()) {
+            try { mDisconnects.execute(cycle::disconnect); }
+            catch (RuntimeException ignored) { /* bounded read/connect timeouts remain in force */ }
+        }
+    }
+
+    private String statusTitle(KeyboxInspector.Status status) {
+        int id;
+        switch (status) {
+            case VALID: case EXPIRING_SOON: id = R.string.ts_monitor_valid; break;
+            case EXPIRED: id = R.string.ts_monitor_expired; break;
+            case REVOKED: id = R.string.ts_monitor_revoked; break;
+            case SUSPENDED: id = R.string.ts_monitor_suspended; break;
+            case MISSING: id = R.string.ts_monitor_missing; break;
+            case CHAIN_INVALID: case UNTRUSTED_ROOT: id = R.string.ts_monitor_invalid; break;
+            default: id = R.string.ts_monitor_unknown;
+        }
+        return mContext.getString(id);
+    }
+
+    private void notifyResult(KeyboxInspector.Report report, KeyboxInspector.Report observed,
+            String recovery, JSONObject saved) {
+        try {
+            NotificationManager nm = mContext.getSystemService(NotificationManager.class);
+            nm.createNotificationChannel(new NotificationChannel(QUIET_CHANNEL,
+                    mContext.getString(R.string.ts_monitor_channel_results), NotificationManager.IMPORTANCE_LOW));
+            nm.createNotificationChannel(new NotificationChannel(ALERT_CHANNEL,
+                    mContext.getString(R.string.ts_monitor_channel_recovery), NotificationManager.IMPORTANCE_DEFAULT));
+            boolean quiet = report.valid() && recovery.isEmpty() && saved.optString("failure").isEmpty();
+            String title = statusTitle(report.status);
+            // Keep technical reason/failure codes in the stored diagnostic report.
+            // User-facing text is localized and retains the original unusable verdict.
+            String text = observed != null && observed.recoverable()
+                    ? statusTitle(observed.status) : "";
+            if (report.expiry > 0) text += "\n" + mContext.getString(R.string.ts_monitor_expiry,
+                    formatTime(report.expiry));
+            if (report.status == KeyboxInspector.Status.UNKNOWN && saved.optLong("confirmedAt") > 0) {
+                text += "\n" + mContext.getString(R.string.ts_monitor_previous,
+                        statusTitle(KeyboxInspector.Status.valueOf(saved.optString("confirmedStatus"))),
+                        formatTime(saved.optLong("confirmedAt")));
+            }
+            if (recovery.equals("replaced")) {
+                title = mContext.getString(R.string.ts_monitor_replaced);
+                text += "\n" + mContext.getString(R.string.ts_monitor_applied);
+            }
+            if (recovery.equals("failed")) {
+                title = mContext.getString(R.string.ts_monitor_failed);
+                text += "\n" + mContext.getString(R.string.ts_monitor_retry);
+            }
+            if (recovery.equals("reload_incomplete")) {
+                title = mContext.getString(R.string.ts_monitor_reload_incomplete);
+                text += "\n" + mContext.getString(R.string.ts_monitor_reload_detail);
+            }
+            long next = getLong(NEXT, 0);
+            text += "\n" + (eligible() && next > 0
+                    ? mContext.getString(R.string.ts_monitor_next, formatTime(next))
+                    : mContext.getString(R.string.ts_monitor_paused));
+            Intent intent = new Intent().setClassName("com.android.settings", "com.android.settings.SubSettings")
+                    .putExtra(":settings:show_fragment", "org.evolution.settings.fragments.miscellaneous.TrickyStore")
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            PendingIntent open = PendingIntent.getActivityAsUser(mContext, 0, intent,
+                    PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE, null, UserHandle.SYSTEM);
+            Notification notification = new Notification.Builder(mContext, quiet ? QUIET_CHANNEL : ALERT_CHANNEL)
+                    .setSmallIcon(android.R.drawable.stat_sys_warning).setContentTitle(title)
+                    .setContentText(text.trim()).setStyle(new Notification.BigTextStyle().bigText(text.trim()))
+                    .setContentIntent(open).setAutoCancel(true).setShowWhen(true).setWhen(System.currentTimeMillis())
+                    .setVisibility(Notification.VISIBILITY_SECRET)
+                    .build();
+            nm.cancelAsUser(TAG, quiet ? ALERT_ID : QUIET_ID, UserHandle.SYSTEM);
+            nm.notifyAsUser(TAG, quiet ? QUIET_ID : ALERT_ID, notification, UserHandle.SYSTEM);
+        } catch (RuntimeException e) { Slog.w(TAG, "Unable to post keybox monitor notification"); }
+    }
+
+    private String formatTime(long millis) {
+        Date date = new Date(millis);
+        return android.text.format.DateFormat.getDateFormat(mContext).format(date) + " "
+                + android.text.format.DateFormat.getTimeFormat(mContext).format(date);
+    }
+
+    private String raw() { return get(KEYBOX); }
+    private String get(String key) {
+        String value = Settings.Secure.getStringForUser(mResolver, key, UserHandle.USER_SYSTEM);
+        return value == null ? "" : value;
+    }
+    private int getInt(String key, int fallback) {
+        return Settings.Secure.getIntForUser(mResolver, key, fallback, UserHandle.USER_SYSTEM);
+    }
+    private long getLong(String key, long fallback) {
+        return Settings.Secure.getLongForUser(mResolver, key, fallback, UserHandle.USER_SYSTEM);
+    }
+    private void put(String key, String value) {
+        if (!Settings.Secure.putStringForUser(mResolver, key, value, UserHandle.USER_SYSTEM)) {
+            if (key.equals(KEYBOX) || key.equals(SOURCE) || key.equals(LAST_FETCHED)) {
+                throw new IllegalStateException("Settings write failed");
+            }
+            Slog.w(TAG, "Keybox metadata write failed");
+        }
+    }
+    private void putLong(String key, long value) { put(key, Long.toString(value)); }
+    private static Bundle error(String failure) {
+        Bundle result = new Bundle(); result.putBoolean("success", false); result.putString("failure", failure);
+        return result;
+    }
+    private static void reply(Request request, Bundle result) {
+        if (request.callback != null) {
+            try { request.callback.sendResult(result); } catch (RuntimeException ignored) { }
+        }
+    }
+
+    private static final class Request {
+        final int operation;
+        final String payload;
+        final RemoteCallback callback;
+        final boolean automatic;
+        final boolean hourly;
+        Request(int operation, String payload, RemoteCallback callback, boolean automatic, boolean hourly) {
+            this.operation = operation; this.payload = payload; this.callback = callback;
+            this.automatic = automatic; this.hourly = hourly;
+        }
+    }
+
+    private final class Cycle implements KeyboxInspector.Network {
+        final Request request;
+        final String before;
+        final String hash;
+        final long generation;
+        final long deadline = SystemClock.elapsedRealtime() + DEADLINE;
+        final PowerManager.WakeLock wakeLock;
+        final ArrayList<HttpURLConnection> connections = new ArrayList<>();
+        volatile boolean cancelled;
+        Future<?> future;
+        volatile KeyboxInspector.Report observed;
+        final Runnable timeout = () -> {
+            if (mCurrent != this) return;
+            if (future != null) future.cancel(true);
+            finish(this, null, null, "CYCLE_TIMEOUT");
+            cancelled = true;
+        };
+        Cycle(Request request, String before, long generation) {
+            this.request = request; this.before = before; this.hash = KeyboxInspector.hash(before);
+            this.generation = generation;
+            wakeLock = mContext.getSystemService(PowerManager.class).newWakeLock(
+                    PowerManager.PARTIAL_WAKE_LOCK, TAG);
+        }
+        @Override public String get(String url, int maxBytes) throws Exception {
+            return get(url, maxBytes, 0);
+        }
+        private String get(String url, int maxBytes, int redirects) throws Exception {
+            if (cancelled || Thread.currentThread().isInterrupted()
+                    || SystemClock.elapsedRealtime() >= deadline) throw new IllegalStateException("cancelled");
+            String fresh = url + (url.contains("?") ? "&" : "?") + "_=" + System.nanoTime();
+            HttpURLConnection connection = (HttpURLConnection) new URL(fresh).openConnection();
+            synchronized (connections) { connections.add(connection); }
+            int timeout = (int) Math.max(1, Math.min(10_000, deadline - SystemClock.elapsedRealtime()));
+            connection.setConnectTimeout(timeout); connection.setReadTimeout(timeout);
+            connection.setUseCaches(false); connection.setRequestProperty("Cache-Control", "no-cache");
+            connection.setInstanceFollowRedirects(false);
+            try {
+                // Official hosts can move. Follow a bounded number of HTTPS redirects only.
+                int code = connection.getResponseCode();
+                if (code == 301 || code == 302 || code == 303 || code == 307 || code == 308) {
+                    String location = connection.getHeaderField("Location");
+                    if (redirects >= 3 || location == null) throw new IllegalStateException("redirect");
+                    URL target = new URL(new URL(url), location);
+                    if (!"https".equals(target.getProtocol())) throw new IllegalStateException("insecure redirect");
+                    return get(target.toString(), maxBytes, redirects + 1);
+                }
+                if (code != 200) throw new IllegalStateException("HTTP_" + code);
+                try (InputStream stream = connection.getInputStream();
+                        ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+                    byte[] buffer = new byte[8192];
+                    int length;
+                    while ((length = stream.read(buffer)) != -1) {
+                        if (cancelled || SystemClock.elapsedRealtime() >= deadline) throw new IllegalStateException("deadline");
+                        if (out.size() + length > maxBytes) throw new IllegalStateException("response too large");
+                        out.write(buffer, 0, length);
+                    }
+                    return out.toString(StandardCharsets.UTF_8);
+                }
+            } finally {
+                connection.disconnect();
+                synchronized (connections) { connections.remove(connection); }
+            }
+        }
+        boolean hasConnections() {
+            synchronized (connections) { return !connections.isEmpty(); }
+        }
+        void disconnect() {
+            ArrayList<HttpURLConnection> copy;
+            synchronized (connections) { copy = new ArrayList<>(connections); }
+            for (HttpURLConnection connection : copy) connection.disconnect();
+        }
+    }
+}
