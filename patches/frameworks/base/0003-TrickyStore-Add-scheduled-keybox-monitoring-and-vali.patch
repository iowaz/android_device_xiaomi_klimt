+/** Performs no writes; an unavailable status service can never produce VALID. */
+final class KeyboxInspector {
+    enum Status { UNKNOWN, MISSING, VALID, EXPIRING_SOON, EXPIRED, REVOKED, SUSPENDED,
+        CHAIN_INVALID, UNTRUSTED_ROOT }
+    static final class Report {
+        final Status status;
+        final String reason;
+        final long expiry;
+        Report(Status status, String reason, long expiry) {
+            this.status = status; this.reason = reason; this.expiry = expiry;
+        }
+        boolean recoverable() {
+            return status == Status.EXPIRED || status == Status.REVOKED || status == Status.SUSPENDED;
+        }
+        boolean valid() { return status == Status.VALID || status == Status.EXPIRING_SOON; }
+    }
+    interface Network { String get(String url, int maxBytes) throws Exception; }
+    static final String OFFICIAL_URL =
+            "https://gitea.com/Evolution-X/keybox/raw/branch/main/keybox.xml";
+    static final String STATUS_URL = "https://android.googleapis.com/attestation/status?encrypted=0";
+    static final String ROOTS_URL = "https://android.googleapis.com/attestation/root";
+    static final String ROOTS_CACHE = "spoof_trickystore_cached_roots";
+    static final String ROOTS_AT = "spoof_trickystore_roots_cached_at";
+    static final long ROOTS_TTL = 30L * 86_400_000;
+    static final int MAX_KEYBOX = android.security.trickystore.KeyboxMonitor.MAX_PAYLOAD_BYTES;
+    private static final Pattern KEYS = Pattern.compile("<Key\\b[^>]*>([\\s\\S]*?)</Key>");
+    private static final Pattern CERTS = Pattern.compile(
+            "-----BEGIN CERTIFICATE-----([\\s\\S]*?)-----END CERTIFICATE-----");
+    private static final Set<String> FALLBACK = Set.of(
+            "1EF1A04B8BA58AB94589AC498C8982A783F24EA7307E0159A0C3A73B377D87CC",
+            "CEDB1CB6DC896AE5EC797348BCE9286753C2B38EE71CE0FBE34A9A1248800DFC",
+            "6D9DB4CE6C5C0B293166D08986E05774A8776CEB525D9E4329520DE12BA4BCC0");
+
+    static String hash(String raw) {
+        return android.security.trickystore.KeyboxMonitor.keyboxHash(raw);
+    }
+
+    static Set<String> roots(String json) throws Exception {
+        JSONArray array = new JSONArray(json);
+        Set<String> keys = new HashSet<>();
+        CertificateFactory factory = CertificateFactory.getInstance("X.509");
+        for (int i = 0; i < array.length(); i++) {
+            X509Certificate cert = (X509Certificate) factory.generateCertificate(
+                    new ByteArrayInputStream(array.getString(i).getBytes(StandardCharsets.UTF_8)));
+            keys.add(Base64.getEncoder().encodeToString(cert.getPublicKey().getEncoded()));
+        }
+        if (keys.isEmpty()) throw new IllegalArgumentException("Empty trust roots");
+        return keys;
+    }
+
+    static Report inspect(String raw, Set<String> trustedRoots, Network network, long now)
+            throws Exception {
+        if (raw == null || raw.isBlank()) return new Report(Status.MISSING, "", 0);
+        String xml = TrickyStoreService.decodeKeybox(raw);
+        if (xml == null || xml.isBlank()) return new Report(Status.CHAIN_INVALID, "INVALID_ENCODING", 0);
+        if (KeyBoxManager.validate(xml) != null) {
+            return new Report(Status.CHAIN_INVALID, "INVALID_KEYBOX", 0);
+        }
+        List<List<X509Certificate>> chains;
+        try { chains = chains(xml); }
+        catch (Exception e) { return new Report(Status.CHAIN_INVALID, "CERT_PARSE_FAILED", 0); }
+        if (chains.isEmpty()) return new Report(Status.CHAIN_INVALID, "EMPTY_CHAIN", 0);
+        long expiry = Long.MAX_VALUE;
+        Set<String> serials = new LinkedHashSet<>();
+        for (List<X509Certificate> chain : chains) {
+            if (chain.size() < 2) return new Report(Status.CHAIN_INVALID, "CHAIN_TOO_SHORT", 0);
+            for (int i = 0; i < chain.size(); i++) {
+                X509Certificate cert = chain.get(i);
+                serials.add(cert.getSerialNumber().toString(16));
+                serials.add(cert.getSerialNumber().toString());
+                // Trust anchors are matched by key, including Google's reissued RSA root.
+                if (i < chain.size() - 1) {
+                    expiry = Math.min(expiry, cert.getNotAfter().getTime());
+                    if (cert.getNotBefore().getTime() > now) {
+                        return new Report(Status.CHAIN_INVALID, "CERT_NOT_YET_VALID", expiry);
+                    }
+                    try { cert.verify(chain.get(i + 1).getPublicKey()); }
+                    catch (Exception e) { return new Report(Status.CHAIN_INVALID, "BAD_SIGNATURE", expiry); }
+                }
+            }
+            X509Certificate root = chain.get(chain.size() - 1);
+            try { root.verify(root.getPublicKey()); }
+            catch (Exception e) { return new Report(Status.CHAIN_INVALID, "ROOT_NOT_SELF_SIGNED", expiry); }
+            String rootKey = Base64.getEncoder().encodeToString(root.getPublicKey().getEncoded());
+            StringBuilder fingerprint = new StringBuilder();
+            for (byte b : MessageDigest.getInstance("SHA-256").digest(root.getEncoded())) {
+                fingerprint.append(String.format(Locale.ROOT, "%02X", b));
+            }
+            if (trustedRoots.isEmpty() ? !FALLBACK.contains(fingerprint.toString())
+                    : !trustedRoots.contains(rootKey)) {
+                return new Report(Status.UNTRUSTED_ROOT, "UNTRUSTED_ROOT", expiry);
+            }
+        }
+        if (now >= expiry) return new Report(Status.EXPIRED, "CERT_EXPIRED", expiry);
+        JSONObject entries;
+        try {
+            entries = new JSONObject(network.get(STATUS_URL, 16 * 1024 * 1024)).getJSONObject("entries");
+        } catch (Exception e) { return new Report(Status.UNKNOWN, "STATUS_UNAVAILABLE", expiry); }
+        for (String serial : serials) {
+            JSONObject entry = entries.optJSONObject(serial);
+            if (entry == null) {
+                if (entries.has(serial)) return new Report(Status.UNKNOWN, "INVALID_STATUS_ENTRY", expiry);
+                continue;
+            }
+            String status = entry.optString("status").toUpperCase(Locale.ROOT);
+            String reason = entry.optString("reason").toUpperCase(Locale.ROOT);
+            if (status.equals("REVOKED")) return new Report(Status.REVOKED, safeReason(reason), expiry);
+            if (status.equals("SUSPENDED")) return new Report(Status.SUSPENDED, safeReason(reason), expiry);
+            // A changed status-list schema must not be interpreted as an all-clear.
+            return new Report(Status.UNKNOWN, "UNRECOGNIZED_STATUS", expiry);
+        }
+        return new Report(expiry - now <= 7L * 86_400_000 ? Status.EXPIRING_SOON : Status.VALID,
+                "", expiry);
+    }
+
+    private static String safeReason(String reason) {
+        return reason.matches("[A-Z_]{1,64}") ? reason : "STATUS_LIST";
+    }
+
+    private static List<List<X509Certificate>> chains(String xml) throws Exception {
+        List<List<X509Certificate>> result = new ArrayList<>();
+        Matcher keys = KEYS.matcher(KeyBoxManager.sanitizeXml(xml));
+        while (keys.find()) {
+            List<X509Certificate> certs = new ArrayList<>();
+            Matcher pem = CERTS.matcher(keys.group(1));
+            CertificateFactory factory = CertificateFactory.getInstance("X.509");
+            while (pem.find()) {
+                X509Certificate cert = (X509Certificate) factory.generateCertificate(
+                        new ByteArrayInputStream(Base64.getMimeDecoder().decode(pem.group(1))));
+                if (!certs.contains(cert)) certs.add(cert);
+            }
+            if (certs.isEmpty()) throw new IllegalArgumentException("Missing certificate");
+            // Input order is not guaranteed: find the certificate which issues no other cert.
+            List<X509Certificate> ordered = new ArrayList<>();
+            for (X509Certificate candidate : certs) {
+                boolean issuer = false;
+                for (X509Certificate other : certs) {
+                    if (!other.equals(candidate) && other.getIssuerX500Principal().equals(
+                            candidate.getSubjectX500Principal())) issuer = true;
+                }
+                if (!issuer) { ordered.add(candidate); break; }
+            }
+            if (ordered.isEmpty()) throw new IllegalArgumentException("No leaf");
+            while (ordered.size() < certs.size()) {
+                X509Certificate last = ordered.get(ordered.size() - 1);
+                X509Certificate next = null;
+                for (X509Certificate candidate : certs) {
+                    if (!ordered.contains(candidate) && last.getIssuerX500Principal().equals(
+                            candidate.getSubjectX500Principal())) {
+                        try { last.verify(candidate.getPublicKey()); next = candidate; break; }
+                        catch (Exception ignored) { }
+                    }
+                }
+                if (next == null) throw new IllegalArgumentException("Disconnected chain");
+                ordered.add(next);
+            }
+            result.add(ordered);
+        }
+        return result;
+    }
+}
