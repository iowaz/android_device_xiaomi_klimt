From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diogo Casteluber Laass <4793368+iowaz@users.noreply.github.com>
Date: Thu, 5 Nov 2026 00:08:41 -0300
Subject: [PATCH] SystemUI: Hold the charging animation still on the always-on
 display

The charging animation's animators invalidate on every vsync. With
"show on AOD" on and the always-on display kept on while charging,
SystemUI drew at the panel's 120 Hz for as long as the phone dozed on
the charger: about half a CPU core in SystemUI, more in SurfaceFlinger
and the composer, and the ambient-light screen capture ran 15 times as
often. Stop the animators while dozing and keep the last frame; start
them again when the device wakes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../systemui/charging/ChargingAnimationView.kt  | 17 ++++++++++++++++-
 .../charging/ChargingAnimationViewController.kt |  1 +
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/packages/SystemUI/src/com/android/systemui/charging/ChargingAnimationView.kt b/packages/SystemUI/src/com/android/systemui/charging/ChargingAnimationView.kt
index 5aa2e3c9d5a0c354ab012bacdb5a4baa0ca2cd76..43399c9fb65728f547a8d00b0fad4b75ac5269b2 100644
--- a/packages/SystemUI/src/com/android/systemui/charging/ChargingAnimationView.kt
+++ b/packages/SystemUI/src/com/android/systemui/charging/ChargingAnimationView.kt
@@ -154,6 +154,21 @@ class ChargingAnimationView(context: Context) : FrameLayout(context) {
             invalidate()
         }
 
+    // On the always-on display the animation is held still: one frame, like the rest of AOD. The animators
+    // invalidate on every vsync, which kept SystemUI drawing at the panel's 120 Hz for as long as the phone
+    // dozed on the charger.
+    var dozing: Boolean = false
+        set(value) {
+            if (field == value) return
+            field = value
+            if (value) {
+                stopAllAnimations()
+                invalidate()
+            } else if (visible && fadeAnimator == null) {
+                startAnimations()
+            }
+        }
+
     private var bubbleAnimator: ValueAnimator? = null
     private var neonAnimator: ValueAnimator? = null
     private var beamAnimator: ValueAnimator? = null
@@ -583,7 +598,7 @@ class ChargingAnimationView(context: Context) : FrameLayout(context) {
     }
 
     private fun startAnimations() {
-        if (!visible) return
+        if (!visible || dozing) return
 
         if (colorMode == COLOR_MODE_RAINBOW) {
             startRainbowAnimation()
diff --git a/packages/SystemUI/src/com/android/systemui/charging/ChargingAnimationViewController.kt b/packages/SystemUI/src/com/android/systemui/charging/ChargingAnimationViewController.kt
index 4a6933a8533116d38aad15ac577975944bcd24f3..9969be93b3bce3dc03789aee92adacc819c054bd 100644
--- a/packages/SystemUI/src/com/android/systemui/charging/ChargingAnimationViewController.kt
+++ b/packages/SystemUI/src/com/android/systemui/charging/ChargingAnimationViewController.kt
@@ -234,6 +234,7 @@ constructor(
 
     override fun onDozingChanged(dozing: Boolean) {
         isDozing = dozing
+        chargingView.dozing = dozing
         updateVisibility()
     }
 
