diff --git a/services/core/java/com/android/server/spoof/KeyboxOperations.java b/services/core/java/com/android/server/spoof/KeyboxOperations.java
new file mode 100644
index 0000000000000000000000000000000000000000..deb2236d56f7b7051606e206e742daf3162b3f9c
--- /dev/null
+++ b/services/core/java/com/android/server/spoof/KeyboxOperations.java
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.spoof;
+
+import static android.security.trickystore.KeyboxMonitor.CHECK;
+import static android.security.trickystore.KeyboxMonitor.FETCH;
+import static android.security.trickystore.KeyboxMonitor.IMPORT;
+
+import android.security.trickystore.KeyBoxManager;
+import java.util.Set;
+import java.util.function.Consumer;
+import java.util.function.LongSupplier;
+
+/** Read-only operation engine. The controller alone owns state writes and scheduling. */
+final class KeyboxOperations {
+    interface Roots { Set<String> load() throws Exception; }
+
+    static final class Result {
+        final String candidate;
+        final KeyboxInspector.Report report;
+        final String failure;
+
+        Result(String candidate, KeyboxInspector.Report report, String failure) {
+            this.candidate = candidate;
+            this.report = report;
+            this.failure = failure;
+        }
+    }
+
+    static boolean hourlyAllowed(boolean monitoring, String source) {
+        return !monitoring && !"user".equals(source);
+    }
+
+    static boolean shouldPublish(boolean hourly, boolean installed, boolean inspectedCurrent) {
+        return installed || !hourly && inspectedCurrent;
+    }
+
+    static Result run(int operation, String before, String payload, boolean hourly,
+            Roots roots, KeyboxInspector.Network network, LongSupplier clock,
+            Consumer<KeyboxInspector.Report> observed) throws Exception {
+        // Preserve the cheap legacy hourly path: an unchanged mirror needs one small
+        // request, no roots/status-list request and no write to the daily-check clock.
+        if (hourly) {
+            String candidate = network.get(KeyboxInspector.OFFICIAL_URL, KeyboxInspector.MAX_KEYBOX);
+            if (KeyboxInspector.hash(candidate).equals(KeyboxInspector.hash(before))) {
+                return new Result(null, null, "UNCHANGED");
+            }
+            KeyboxInspector.Report checked = KeyboxInspector.inspect(candidate, roots.load(), network, clock.getAsLong());
+            return checked.valid() ? new Result(candidate, checked, "")
+                    : new Result(null, null, "CANDIDATE_" + checked.status);
+        }
+        String input = operation == IMPORT ? payload : before;
+        if (operation == IMPORT && (input == null || KeyBoxManager.validate(input) != null)) {
+            return new Result(null, null, "INVALID_KEYBOX");
+        }
+        // A manual import is the user's explicit payload choice. Preserve upstream's
+        // offline import path; Settings follows it with the shared status check.
+        if (operation == IMPORT) return new Result(input, null, "");
+        Set<String> trusted = roots.load();
+        KeyboxInspector.Report initial = KeyboxInspector.inspect(input, trusted, network, clock.getAsLong());
+        observed.accept(initial);
+        if (operation == CHECK && !initial.recoverable()) return new Result(null, initial, "");
+        String candidate = network.get(KeyboxInspector.OFFICIAL_URL, KeyboxInspector.MAX_KEYBOX);
+        if (KeyboxInspector.hash(candidate).equals(KeyboxInspector.hash(before))) {
+            return new Result(null, initial, initial.valid() ? "UNCHANGED" : "CANDIDATE_" + initial.status);
+        }
+        KeyboxInspector.Report checked = KeyboxInspector.inspect(candidate, trusted, network, clock.getAsLong());
+        return checked.valid() ? new Result(candidate, checked, "")
+                : new Result(null, initial, "CANDIDATE_" + checked.status);
+    }
+}
