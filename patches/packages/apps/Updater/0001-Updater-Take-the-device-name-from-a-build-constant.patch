From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diogo Casteluber Laass <4793368+iowaz@users.noreply.github.com>
Date: Mon, 19 Oct 2026 20:46:19 -0300
Subject: [PATCH] Updater: Take the device name from a build constant

The OTA server, blocked-update and changelog URLs fell back to
ro.evolution.device when ro.updater.next_device is unset. That prop is
gone; fall back to org.evolution.build.Device.VALUE (generated by
vendor/lineage/build/soong/evolution-build-info) instead. It holds the
same value (klimt), so the URLs don't change.

evox27: upstream rewrote the Updater in Kotlin; the device name now
comes from DeviceInfoUtils.device, so the change moves there and drops
its PROP_DEVICE.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/Android.bp                                                 | 1 +
 .../java/org/evolution/updater/data/ChangelogRepository.kt     | 2 +-
 .../java/org/evolution/updater/deviceinfo/DeviceInfoUtils.kt   | 3 +--
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/app/Android.bp b/app/Android.bp
index 2ca1e4b6e0c8b9427961a97f7f3b79798dc1c6d5..59f15464f2d98f98e315ae0f0c8c5578bc8fb4bb 100644
--- a/app/Android.bp
+++ b/app/Android.bp
@@ -11,6 +11,7 @@ android_app {
     srcs: [
         "src/main/java/**/*.java",
         "src/main/java/**/*.kt",
+        ":evolution-build-info-device",
     ],
 
     resource_dirs: ["src/main/res"],
diff --git a/app/src/main/java/org/evolution/updater/data/ChangelogRepository.kt b/app/src/main/java/org/evolution/updater/data/ChangelogRepository.kt
index dba1ac1a212b8abfd78501f23e3a8997898d560f..6ffc9858d014cd14bad96ef40bff13ad3541ae60 100644
--- a/app/src/main/java/org/evolution/updater/data/ChangelogRepository.kt
+++ b/app/src/main/java/org/evolution/updater/data/ChangelogRepository.kt
@@ -38,7 +38,7 @@ class ChangelogRepository(private val context: Context) {
     suspend fun fetchChangelog(update: Update): String =
         withContext(Dispatchers.IO) {
             val device = DeviceInfoUtils.device
-            require(device.isNotBlank()) { "Missing ro.evolution.device" }
+            require(device.isNotBlank()) { "Missing device name" }
 
             val key = "$device/${update.downloadId}"
             if (cachedKey == key) {
diff --git a/app/src/main/java/org/evolution/updater/deviceinfo/DeviceInfoUtils.kt b/app/src/main/java/org/evolution/updater/deviceinfo/DeviceInfoUtils.kt
index ab671bfb36535b92960d36d2d240556e89bd2942..00da21cec7bd9ac7cb7601b270b8e7d5841ab4c3 100644
--- a/app/src/main/java/org/evolution/updater/deviceinfo/DeviceInfoUtils.kt
+++ b/app/src/main/java/org/evolution/updater/deviceinfo/DeviceInfoUtils.kt
@@ -15,7 +15,6 @@ object DeviceInfoUtils : SettingsLibDeviceInfoUtils() {
     private const val PROP_ALLOW_MAJOR_UPGRADES = "evolution.updater.allow_major_upgrades"
     private const val PROP_BUILD_DATE = "ro.build.date.utc"
     private const val PROP_BUILD_VERSION = "ro.modversion"
-    private const val PROP_DEVICE = "ro.evolution.device"
     private const val PROP_NEXT_DEVICE = "ro.updater.next_device"
     private const val PROP_UPDATER_ALLOW_DOWNGRADING = "evolution.updater.allow_downgrading"
     private const val PROP_UPDATER_URI = "evolution.updater.uri"
@@ -35,7 +34,7 @@ object DeviceInfoUtils : SettingsLibDeviceInfoUtils() {
     val buildVersion: String = SystemProperties.get(PROP_BUILD_VERSION, "")
 
     @JvmStatic
-    val device: String = SystemProperties.get(PROP_NEXT_DEVICE, SystemProperties.get(PROP_DEVICE))
+    val device: String = SystemProperties.get(PROP_NEXT_DEVICE, org.evolution.build.Device.VALUE)
 
     @JvmStatic
     val isABDevice: Boolean = SystemProperties.getBoolean(PROP_AB_DEVICE, false)
