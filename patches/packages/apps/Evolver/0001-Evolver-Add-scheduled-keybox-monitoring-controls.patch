+<resources>
+    <string name="ts_monitor_title">Scheduled keybox monitoring</string>
+    <string name="ts_monitor_enabled">Automatically check and recover keybox</string>
+    <string name="ts_monitor_description">Check during standby, quietly notify when valid, and fetch an official replacement if expired or revoked. A replacement also reloads Google processes. Frequent checks use more battery.</string>
+    <string name="ts_monitor_interval">Check interval</string>
+    <string name="ts_monitor_schedule">Schedule</string>
+    <string name="ts_monitor_minutes">%1$d minutes</string>
+    <string name="ts_monitor_hours">%1$d hours</string>
+    <string name="ts_monitor_next_check">Next check: %1$s</string>
+    <string name="ts_monitor_off">Automatic monitoring is off</string>
+    <string name="ts_monitor_paused">Paused while TrickyStore is off</string>
+    <string name="ts_monitor_rkp_paused">Paused while device RKP is enabled</string>
+    <string name="ts_monitor_starting">Starting automatic checks…</string>
+    <string name="ts_monitor_missing">Waiting for a keybox to be imported or fetched</string>
+    <string name="ts_monitor_expired">Expired</string>
+    <string name="ts_monitor_unknown">Unable to verify keybox</string>
+    <string name="ts_monitor_one_hour">1 hour</string>
+    <string name="ts_monitor_last_confirmed">Last confirmed: %1$s at %2$s</string>
+</resources>
