+<resources>
+    <string name="ts_monitor_title">Scheduled keybox monitoring</string>
+    <string name="ts_monitor_enabled">Automatically check and recover keybox</string>
+    <string name="ts_monitor_description">Check during standby and fetch an official replacement if expired, revoked or suspended. A replacement reloads Google processes without clearing app data. Frequent checks use more battery.</string>
+    <string name="ts_monitor_interval">Check interval</string>
+    <string name="ts_monitor_schedule">Schedule</string>
+    <string name="ts_monitor_minutes">%1$d minutes</string>
+    <string name="ts_monitor_hours">%1$d hours</string>
+    <string name="ts_monitor_next_check">Next check: %1$s</string>
+    <string name="ts_monitor_off">Automatic monitoring is off</string>
+    <string name="ts_monitor_paused">Paused while TrickyStore is off</string>
+    <string name="ts_monitor_rkp_paused">Paused while device RKP is enabled</string>
+    <string name="ts_monitor_starting">Starting automatic checks…</string>
+    <string name="ts_monitor_missing">Waiting for a keybox to be imported or fetched</string>
+    <string name="ts_monitor_expired">Expired</string>
+    <string name="ts_monitor_unknown">Unable to verify keybox</string>
+    <string name="ts_monitor_one_hour">1 hour</string>
+    <string name="ts_monitor_last_confirmed">Last confirmed: %1$s at %2$s</string>
+    <string name="ts_monitor_notifications">Notifications</string>
+    <string name="ts_monitor_notify_every">Every check, whatever the result</string>
+    <string name="ts_monitor_notify_unusable">Expired, revoked or suspended, including successful recovery</string>
+    <string name="ts_monitor_notify_failed">Only when an expired, revoked or suspended keybox cannot be recovered (default)</string>
+    <string name="ts_monitor_operation_failed">Unable to complete the keybox operation. Check your connection and try again.</string>
+    <string name="ts_monitor_bad_file">The keybox file is invalid or could not be verified. The installed keybox was kept.</string>
+    <string name="ts_monitor_disabled_operation">Keybox operations require TrickyStore to be enabled and device RKP to be disabled.</string>
+    <string name="ts_monitor_busy">A keybox operation is already running. Try again shortly.</string>
+    <string name="ts_monitor_state_changed">The keybox or its configuration changed. Check the current status and try again.</string>
+    <string name="ts_monitor_reload_incomplete">The keybox was installed, but some Google processes could not be reloaded. Restart the phone when convenient.</string>
+    <string name="ts_monitor_storage_failed">The keybox could not be saved safely. Check available storage and try again.</string>
+    <string name="ts_monitor_no_replacement">No valid official replacement is available right now. The installed keybox was kept.</string>
+</resources>
