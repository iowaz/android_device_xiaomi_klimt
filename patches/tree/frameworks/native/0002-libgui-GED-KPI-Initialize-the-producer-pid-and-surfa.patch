From 050255ce02ecf09c107d941985f19ee5cefec081 Mon Sep 17 00:00:00 2001
From: Diogo Casteluber Laass <4793368+iowaz@users.noreply.github.com>
Date: Thu, 29 Oct 2026 20:07:21 -0300
Subject: [PATCH 2/3] libgui: GED KPI: Initialize the producer pid and
 surfaceflinger flag

The MediaTek GED KPI hooks pass mPid and mIsSurfaceFlinger to the GED
driver on every dequeue and queue, but only connect() from EGL sets
them. Surfaces that connect with another API (camera, media codecs,
CPU rendering) sent whatever was in memory; isSF=1 makes the driver
take that pid as surfaceflinger's.

Start them at -1 and false. Declare them without the
ENABLE_MTK_GED_KPI guard: the define is private to libgui, so other
modules saw a Surface layout without the two members. Also skip the
queue hook if the slot's buffer was already released.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/gui/Surface.cpp           | 2 +-
 libs/gui/include/gui/Surface.h | 9 +++++----
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/libs/gui/Surface.cpp b/libs/gui/Surface.cpp
index c629e8e..d4f2755 100644
--- a/libs/gui/Surface.cpp
+++ b/libs/gui/Surface.cpp
@@ -1590,7 +1590,7 @@ void Surface::onBufferQueuedLocked(int slot, const sp<Fence>& fence,
     mQueueBufferCondition.broadcast();
 
     #ifdef ENABLE_MTK_GED_KPI
-    if (mGraphicBufferProducer != nullptr && ged_fd >= 0) {
+    if (mGraphicBufferProducer != nullptr && ged_fd >= 0 && mSlots[slot].buffer != nullptr) {
         sp<GraphicBuffer>& gbuf(mSlots[slot].buffer);
         uint64_t uniqueId;
         mGraphicBufferProducer->getUniqueId(&uniqueId);
diff --git a/libs/gui/include/gui/Surface.h b/libs/gui/include/gui/Surface.h
index 99ef451..1260ef5 100644
--- a/libs/gui/include/gui/Surface.h
+++ b/libs/gui/include/gui/Surface.h
@@ -900,10 +900,11 @@ protected:
     // Buffers that are successfully dequeued/attached and handed to clients
     std::unordered_set<int> mDequeuedSlots;
 
-    #ifdef ENABLE_MTK_GED_KPI
-    pid_t mPid;
-    bool mIsSurfaceFlinger;
-    #endif
+    // MediaTek GED KPI (libgui/support_mtk_ged_kpi): the producer's pid and whether it is
+    // surfaceflinger. Declared for every build so that all modules see the class layout libgui
+    // was compiled with; only set when connect() comes from EGL.
+    pid_t mPid = -1;
+    bool mIsSurfaceFlinger = false;
 
     // Indicates whether this surface holds the mouse cursor, and subsequently determines whether
     // the GRALLOC_USAGE_CURSOR usage flag should be set on the buffer created when this surface is
