From 829dab06450fd192e7fb0115b639b8066052be89 Mon Sep 17 00:00:00 2001
From: Diogo Casteluber Laass <4793368+iowaz@users.noreply.github.com>
Date: Wed, 21 Oct 2026 01:02:37 -0300
Subject: [PATCH] AxSpoofManager: seed default Pixel (bluejay) PIF config at
 boot when empty

The app-facing device identity (Build.MANUFACTURER/BRAND/MODEL/DEVICE/
FINGERPRINT) is spoofed to the default Pixel profile for app processes via
bionic custom_rom_hide, which serves the persist.sys.pif.* props that
stagePifPropOverrides() populates from Settings.Secure.SPOOF_PIF_CONFIG. The
hourly auto-refresh that writes that config is gated by a one-day cooldown
(LAST_AUTO_FETCH_KEY); if the config is ever empty while the cooldown is live,
the staging props stay empty and apps fall back to the device's real klimt
identity (and DroidGuard reads the static build.prop fingerprint), which is how
the product identity and Play Integrity DEVICE/STRONG can silently regress.

Seed the config from the hardcoded default profile (PIF_DEFAULT_CODENAME =
bluejay / Pixel 6a) in systemReady()'s already-activated branch, only when the
config is currently empty, so a complete and consistent Pixel 6a identity
stages from first boot. A populated or user-imported config is left untouched.
Reads only the in-memory/hardcoded profile (no network, non-blocking), writes
only SPOOF_PIF_CONFIG, and does not touch the activation gate or restart GMS,
so firmware/HAL/KeyMint attestation keep reading the genuine klimt identity.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 .../android/server/spoof/AxSpoofManager.java  | 42 +++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/services/core/java/com/android/server/spoof/AxSpoofManager.java b/services/core/java/com/android/server/spoof/AxSpoofManager.java
index 62dfde61b082..5182aaedabec 100644
--- a/services/core/java/com/android/server/spoof/AxSpoofManager.java
+++ b/services/core/java/com/android/server/spoof/AxSpoofManager.java
@@ -203,6 +203,7 @@ public class AxSpoofManager implements IAxSpoofManager {
                 mResolver, ACTIVATED_KEY, 0, UserHandle.USER_SYSTEM) != 0;
         if (mActivated) {
             seedDefaultTargetsIfUnset();
+            ensurePifConfigSeeded();
             stagePifPropOverrides(getCached(Settings.Secure.SPOOF_PIF_CONFIG));
         } else {
             Log.i(TAG, "Spoofing off until Settings is opened for the first time");
@@ -911,6 +912,47 @@ public class AxSpoofManager implements IAxSpoofManager {
                 : Character.toUpperCase(s.charAt(0)) + s.substring(1);
     }
 
+    /**
+     * evox24: guarantee the default Pixel (bluejay / Pixel 6a) identity is staged for
+     * apps from the first boot. The hourly auto-refresh is gated by its own one-day
+     * cooldown (LAST_AUTO_FETCH_KEY); if the config was ever cleared while that cooldown
+     * was live, SPOOF_PIF_CONFIG -- and therefore every persist.sys.pif.* app-facing
+     * identity prop that bionic custom_rom_hide serves -- stays empty until the cooldown
+     * expires, leaving apps on the device's real klimt identity. Seed the default profile
+     * only when the config is missing; a populated or user-imported config is left
+     * untouched. App-process scoped, so firmware/HAL/KeyMint attestation keep reading the
+     * genuine klimt identity.
+     */
+    private void ensurePifConfigSeeded() {
+        if (mResolver == null) return;
+        final String content = getCached(Settings.Secure.SPOOF_PIF_CONFIG);
+        if (content != null && !content.trim().isEmpty()) return;
+        try {
+            PixelDeviceRepository.PixelProfile p = PixelDeviceRepository.getProfileByCodename(
+                    mContext, PixelDeviceRepository.PIF_DEFAULT_CODENAME, false);
+            if (p == null || !PixelDeviceRepository.isValidFingerprint(p.fingerprint)) {
+                Log.w(TAG, "No valid default PIF profile to seed");
+                return;
+            }
+            JSONObject cfg = new JSONObject();
+            cfg.put("MANUFACTURER", capitalize(p.brand));
+            cfg.put("BRAND", p.brand);
+            cfg.put("MODEL", p.model);
+            cfg.put("PRODUCT", p.product);
+            cfg.put("DEVICE", p.device);
+            cfg.put("FINGERPRINT", p.fingerprint);
+            cfg.put("SECURITY_PATCH", p.securityPatch);
+            cfg.put("DEVICE_INITIAL_SDK_INT", PIF_DEVICE_INITIAL_SDK);
+            Settings.Secure.putStringForUser(mResolver, Settings.Secure.SPOOF_PIF_CONFIG,
+                    cfg.toString(2), UserHandle.USER_SYSTEM);
+            refreshKey(Settings.Secure.SPOOF_PIF_CONFIG);
+            Log.i(TAG, "Seeded default Pixel (" + PixelDeviceRepository.PIF_DEFAULT_CODENAME
+                    + ") PIF config so the app-facing identity stages from boot");
+        } catch (Exception e) {
+            Log.w(TAG, "Failed to seed default PIF config", e);
+        }
+    }
+
     private String getCached(String key) {
         return mCache.get(key);
     }
