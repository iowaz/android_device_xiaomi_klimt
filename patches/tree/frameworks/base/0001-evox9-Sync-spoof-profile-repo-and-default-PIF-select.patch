+        for (PixelProfile p : available) {
+            if (PIF_DEFAULT_CODENAME.equals(p.codename)) return PIF_DEFAULT_CODENAME;
         }
-        return A_SERIES_ORDER.get(newestIndex);
+        return getDefaultPhoneCodename(available);
     }
 
