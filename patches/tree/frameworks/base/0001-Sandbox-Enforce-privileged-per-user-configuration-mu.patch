From f60f8d1357b56a5f0b946926defe13deae943d31 Mon Sep 17 00:00:00 2001
From: Diogo Casteluber Laass <4793368+iowaz@users.noreply.github.com>
Date: Wed, 14 Oct 2026 15:56:23 -0300
Subject: [PATCH] Sandbox: Enforce privileged per-user configuration mutations

---
 .../server/am/ActivityManagerService.java      | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/services/core/java/com/android/server/am/ActivityManagerService.java b/services/core/java/com/android/server/am/ActivityManagerService.java
index 99b7fbe85342..dfd8e2c221d1 100644
--- a/services/core/java/com/android/server/am/ActivityManagerService.java
+++ b/services/core/java/com/android/server/am/ActivityManagerService.java
@@ -21345,6 +21345,13 @@ public class ActivityManagerService extends IActivityManager.Stub
         return mThreeFingersSwipeEnabled && mThreeFingerGestureActive;
     }
 
+    private int resolveSandboxMutationUser(int userId, String operation) {
+        mContext.enforceCallingOrSelfPermission(
+                android.Manifest.permission.WRITE_SECURE_SETTINGS, operation);
+        return mUserController.handleIncomingUser(Binder.getCallingPid(), Binder.getCallingUid(),
+                userId, false /* allowAll */, ALLOW_FULL_ONLY, operation, null);
+    }
+
     @Override
     public boolean isSandboxAppLocked(String packageName, int userId) {
         return AxSandboxService.getInstance().isAppLocked(packageName, userId);
@@ -21367,21 +21374,25 @@ public class ActivityManagerService extends IActivityManager.Stub
 
     @Override
     public void addSandboxLockedApp(String packageName, int userId) {
+        userId = resolveSandboxMutationUser(userId, "addSandboxLockedApp");
         AxSandboxService.getInstance().addLockedApp(packageName, userId);
     }
 
     @Override
     public void removeSandboxLockedApp(String packageName, int userId) {
+        userId = resolveSandboxMutationUser(userId, "removeSandboxLockedApp");
         AxSandboxService.getInstance().removeLockedApp(packageName, userId);
     }
 
     @Override
     public void setSandboxPackageHidden(String packageName, boolean hidden, int userId) {
+        userId = resolveSandboxMutationUser(userId, "setSandboxPackageHidden");
         AxSandboxService.getInstance().setPackageHidden(packageName, hidden, userId);
     }
 
     @Override
     public void setSandboxPackageHiddenFromLauncher(String packageName, boolean hidden, int userId) {
+        userId = resolveSandboxMutationUser(userId, "setSandboxPackageHiddenFromLauncher");
         AxSandboxService.getInstance().setPackageHiddenFromLauncher(packageName, hidden, userId);
     }
 
@@ -21412,11 +21423,13 @@ public class ActivityManagerService extends IActivityManager.Stub
 
     @Override
     public void unlockSandboxApp(String packageName, int userId) {
+        userId = resolveSandboxMutationUser(userId, "unlockSandboxApp");
         AxSandboxService.getInstance().unlockApp(packageName, userId);
     }
 
     @Override
     public void promptSandboxUnlock(String packageName, int userId) {
+        userId = resolveSandboxMutationUser(userId, "promptSandboxUnlock");
         AxSandboxService.getInstance().promptUnlock(packageName, userId);
     }
 
@@ -21472,11 +21485,13 @@ public class ActivityManagerService extends IActivityManager.Stub
 
     @Override
     public void addSandboxPackage(String packageName, int userId) {
+        userId = resolveSandboxMutationUser(userId, "addSandboxPackage");
         AxSandboxService.getInstance().addSandboxedPackage(packageName, userId);
     }
 
     @Override
     public void removeSandboxPackage(String packageName, int userId) {
+        userId = resolveSandboxMutationUser(userId, "removeSandboxPackage");
         AxSandboxService.getInstance().removeSandboxedPackage(packageName, userId);
     }
 
@@ -21487,6 +21502,7 @@ public class ActivityManagerService extends IActivityManager.Stub
 
     @Override
     public void setSandboxRestrictedGids(String packageName, int[] gids, int userId) {
+        userId = resolveSandboxMutationUser(userId, "setSandboxRestrictedGids");
         AxSandboxService.getInstance().setRestrictedGids(packageName, gids, userId);
     }
 
@@ -21502,6 +21518,7 @@ public class ActivityManagerService extends IActivityManager.Stub
  
     @Override
     public void setSandboxDataIsolationEnabled(String packageName, boolean enabled, int userId) {
+        userId = resolveSandboxMutationUser(userId, "setSandboxDataIsolationEnabled");
         AxSandboxService.getInstance().setSandboxDataIsolationEnabled(packageName, enabled, userId);
     }
  
@@ -21513,6 +21530,7 @@ public class ActivityManagerService extends IActivityManager.Stub
     @Override
     public void setSandboxSpoofSettingEnabled(String packageName, String settingKey,
             boolean enabled, int userId) {
+        userId = resolveSandboxMutationUser(userId, "setSandboxSpoofSettingEnabled");
         AxSandboxService.getInstance().setSpoofSettingEnabled(packageName, settingKey, enabled, userId);
     }
  
