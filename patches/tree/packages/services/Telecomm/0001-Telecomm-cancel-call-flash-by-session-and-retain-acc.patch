From 9e1349dc623b5945c0181f4e925d2fe015fd77df Mon Sep 17 00:00:00 2001
From: Diogo Casteluber Laass <4793368+iowaz@users.noreply.github.com>
Date: Wed, 14 Oct 2026 15:37:10 -0300
Subject: [PATCH] Telecomm: cancel call flash by session and retain
 accessibility default

---
 src/com/android/server/telecom/Ringer.java | 101 ++++++++++++++++-----
 1 file changed, 77 insertions(+), 24 deletions(-)

diff --git a/src/com/android/server/telecom/Ringer.java b/src/com/android/server/telecom/Ringer.java
index 5bea4c9..fe12822 100644
--- a/src/com/android/server/telecom/Ringer.java
+++ b/src/com/android/server/telecom/Ringer.java
@@ -29,6 +29,7 @@ import android.content.Context;
 import android.content.pm.PackageManager;
 import android.content.res.Resources;
 import android.hardware.camera2.CameraManager;
+import android.hardware.camera2.CameraCharacteristics;
 import android.media.AudioAttributes;
 import android.media.AudioManager;
 import android.media.Ringtone;
@@ -295,7 +296,8 @@ public class Ringer {
     private CompletableFuture<Void> mBlockOnRingingFuture = null;
 
     private Handler mTorchHandler;
-    private boolean mIsFlashing;
+    // Protected by mLock; each runnable owns exactly one ringing session.
+    private TorchToggler mTorchToggler;
 
     private InCallTonePlayer mCallWaitingPlayer;
     private RingtoneFactory mRingtoneFactory;
@@ -539,9 +541,21 @@ public class Ringer {
                 shouldFlash = zenMode == ZEN_MODE_OFF;
             }
 
+            // Preserve the accessibility flash notification path when the custom
+            // call-flash feature is disabled. The custom path is an explicit opt-in.
+            if (torchMode == 0 && mAccessibilityManagerAdapter != null
+                    && mRingerAttributes.shouldRingForContact()) {
+                Log.addEvent(foregroundCall, LogUtils.Events.FLASH_NOTIFICATION_START);
+                getExecutor().execute(() ->
+                        mAccessibilityManagerAdapter.startFlashNotificationSequence(mContext,
+                                1 /* FLASH_REASON_CALL = 1 */));
+            }
+
             if (shouldFlash) {
                 synchronized (mLock) {
-                    getTorchHandler().post(new TorchToggler());
+                    stopTorchLocked();
+                    mTorchToggler = new TorchToggler();
+                    getTorchHandler().post(mTorchToggler);
                 }
             }
 
@@ -827,6 +841,7 @@ public class Ringer {
         }
 
         synchronized (mLock) {
+            stopTorchLocked();
             if (mRingerAttributes != null
                     && mRingerAttributes.getRingtoneType() == Call.RINGTONE_SOURCE_LOCAL) {
                 if (mRingingCall != null) {
@@ -834,8 +849,6 @@ public class Ringer {
                     mRingingCall = null;
                 }
                 mRingtonePlayer.stop();
-                mIsFlashing = false;
-                getTorchHandler().removeCallbacksAndMessages(null);
             }
             if (foregroundCall != null && mCrsAudioController != null) {
                 mCrsAudioController.resetCrsAudioVolume(foregroundCall, mRingerAttributes);
@@ -1197,33 +1210,73 @@ public class Ringer {
         }
     }
 
-    private class TorchToggler implements Runnable {
-        private CameraManager cameraManager;
-        private int duration;
-        private boolean hasFlash = true;
-
-        public TorchToggler() {
-            cameraManager = (CameraManager) mContext.getSystemService(Context.CAMERA_SERVICE);
-            hasFlash = mContext.getPackageManager().hasSystemFeature(PackageManager.FEATURE_CAMERA_FLASH);
-            duration = 500 / Settings.System.getInt(mContext.getContentResolver(),
-                    FLASHLIGHT_ON_CALL_RATE, 1);
+    private void stopTorchLocked() {
+        TorchToggler toggler = mTorchToggler;
+        mTorchToggler = null;
+        if (toggler != null) {
+            getTorchHandler().removeCallbacks(toggler);
+            // Cleanup is ordered before a newer session's first step on this handler.
+            getTorchHandler().post(toggler::stop);
         }
+    }
+
+    private class TorchToggler implements Runnable {
+        private final CameraManager cameraManager =
+                (CameraManager) mContext.getSystemService(Context.CAMERA_SERVICE);
+        private final long duration = Math.max(1, 500 / Math.max(1,
+                Settings.System.getInt(mContext.getContentResolver(), FLASHLIGHT_ON_CALL_RATE, 1)));
+        private String cameraId;
+        private boolean torchOn;
 
         @Override
         public void run() {
-            if (hasFlash) {
-                mIsFlashing = true;
+            synchronized (mLock) {
+                if (mTorchToggler != this) return;
                 try {
-                    String cameraId = cameraManager.getCameraIdList()[0];
-                    while (mIsFlashing) {
-                        cameraManager.setTorchMode(cameraId, true);
-                        Thread.sleep(duration);
-
-                        cameraManager.setTorchMode(cameraId, false);
-                        Thread.sleep(duration);
+                    if (cameraManager == null || !mContext.getPackageManager()
+                            .hasSystemFeature(PackageManager.FEATURE_CAMERA_FLASH)) {
+                        mTorchToggler = null;
+                        return;
+                    }
+                    if (cameraId == null) {
+                        for (String id : cameraManager.getCameraIdList()) {
+                            if (Boolean.TRUE.equals(cameraManager.getCameraCharacteristics(id)
+                                    .get(CameraCharacteristics.FLASH_INFO_AVAILABLE))) {
+                                cameraId = id;
+                                break;
+                            }
+                        }
+                        if (cameraId == null) {
+                            mTorchToggler = null;
+                            return;
+                        }
                     }
+                    boolean nextTorchOn = !torchOn;
+                    // An enable request may succeed before its Binder reply fails.
+                    // Keep cleanup armed until a disable request succeeds.
+                    if (nextTorchOn) torchOn = true;
+                    cameraManager.setTorchMode(cameraId, nextTorchOn);
+                    torchOn = nextTorchOn;
+                    if (!getTorchHandler().postDelayed(this, duration)) {
+                        mTorchToggler = null;
+                        stop();
+                    }
+                } catch (Exception e) {
+                    Log.e(TAG, "Cannot flash incoming-call torch", e);
+                    mTorchToggler = null;
+                    stop();
+                }
+            }
+        }
+
+        private void stop() {
+            if (cameraId != null && torchOn) {
+                try {
+                    cameraManager.setTorchMode(cameraId, false);
                 } catch (Exception e) {
-                    e.printStackTrace();
+                    Log.w(TAG, "Cannot turn incoming-call torch off", e);
+                } finally {
+                    torchOn = false;
                 }
             }
         }
