From 34d03ec0a4c33d82079f1a4688575a061776f1dd Mon Sep 17 00:00:00 2001
From: Diogo Casteluber Laass <4793368+iowaz@users.noreply.github.com>
Date: Wed, 14 Oct 2026 15:56:23 -0300
Subject: [PATCH] AppLocker: Declare permissions for the guarded per-user
 manager

---
 AndroidManifest.xml                         | 2 ++
 privapp_whitelist_com.android.applocker.xml | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index aaedbc3..6f42abf 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -12,6 +12,8 @@
         android:minSdkVersion="35"
         android:targetSdkVersion="36"/>
     <uses-permission android:name="android.permission.MANAGE_USERS"/>
+    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>
+    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL"/>
     <uses-permission android:name="android.permission.REAL_GET_TASKS"/>
     <uses-permission android:name="android.permission.GET_DETAILED_TASKS"/>
     <uses-permission android:name="android.permission.USE_BIOMETRIC_INTERNAL"/>
diff --git a/privapp_whitelist_com.android.applocker.xml b/privapp_whitelist_com.android.applocker.xml
index c40358d..98b502c 100644
--- a/privapp_whitelist_com.android.applocker.xml
+++ b/privapp_whitelist_com.android.applocker.xml
@@ -4,5 +4,7 @@
         <permission name="android.permission.REAL_GET_TASKS"/>
         <permission name="android.permission.GET_DETAILED_TASKS"/>
         <permission name="android.permission.MANAGE_USERS"/>
+        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
+        <permission name="android.permission.INTERACT_ACROSS_USERS_FULL"/>
     </privapp-permissions>
 </permissions>
