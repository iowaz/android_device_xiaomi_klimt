From 1ead6ac0ecf3940ccf4ab504d87ff8610547f38c Mon Sep 17 00:00:00 2001
From: Diogo Casteluber Laass <4793368+iowaz@users.noreply.github.com>
Date: Wed, 14 Oct 2026 15:43:36 -0300
Subject: [PATCH 1/4] ThemeStore: Wait for terminal install status after user
 confirmation

---
 src/com/android/axion/axthemestore/install/ThemeInstaller.kt | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/com/android/axion/axthemestore/install/ThemeInstaller.kt b/src/com/android/axion/axthemestore/install/ThemeInstaller.kt
index a7ed81e..578a08c 100644
--- a/src/com/android/axion/axthemestore/install/ThemeInstaller.kt
+++ b/src/com/android/axion/axthemestore/install/ThemeInstaller.kt
@@ -67,6 +67,7 @@ class ThemeInstaller(private val context: Context) {
                 when (status) {
                     PackageInstaller.STATUS_SUCCESS -> {
                         trySend(InstallResult.Success)
+                        close()
                     }
                     PackageInstaller.STATUS_PENDING_USER_ACTION -> {
                         val confirmIntent = intent.getParcelableExtra<Intent>(Intent.EXTRA_INTENT)
@@ -77,10 +78,10 @@ class ThemeInstaller(private val context: Context) {
                     }
                     else -> {
                         trySend(InstallResult.Failure(status, message))
+                        close()
                     }
                 }
-                
-                close()
+
             }
         }
         
