From a755c13755235f79f1e85a4808c7399042f2bedd Mon Sep 17 00:00:00 2001
From: Diogo Casteluber Laass <4793368+iowaz@users.noreply.github.com>
Date: Wed, 14 Oct 2026 16:02:11 -0300
Subject: [PATCH 3/4] ThemeStore: Preserve per-app icon pack assignments during
 theme updates

---
 .../axion/axthemestore/engine/ThemeEngineProxy.kt      | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/com/android/axion/axthemestore/engine/ThemeEngineProxy.kt b/src/com/android/axion/axthemestore/engine/ThemeEngineProxy.kt
index aabab1e..1cbb37e 100644
--- a/src/com/android/axion/axthemestore/engine/ThemeEngineProxy.kt
+++ b/src/com/android/axion/axthemestore/engine/ThemeEngineProxy.kt
@@ -83,7 +83,15 @@ class ThemeEngineProxy(private val context: Context) {
 
     private fun saveThemeConfig(config: ThemeEngineConfig): Boolean {
         return try {
-            val json = serializeConfig(config)
+            val jsonObject = JSONObject(serializeConfig(config))
+            val existingJson = Settings.Secure.getString(
+                context.contentResolver, SETTINGS_THEME_ENGINE_DATA)
+            if (!existingJson.isNullOrBlank()) {
+                JSONObject(existingJson).optJSONObject("perAppIconPacks")?.let {
+                    jsonObject.put("perAppIconPacks", it)
+                }
+            }
+            val json = jsonObject.toString()
             Settings.Secure.putString(context.contentResolver, SETTINGS_THEME_ENGINE_DATA, json)
             Log.d(TAG, "Saved theme config: $json")
             true
