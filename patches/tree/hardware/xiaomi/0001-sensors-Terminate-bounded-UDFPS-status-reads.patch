From f8f00fcc11b8bf5a5ea82ddaae9a3c62b120861a Mon Sep 17 00:00:00 2001
From: Diogo Casteluber Laass <4793368+iowaz@users.noreply.github.com>
Date: Wed, 14 Oct 2026 15:14:53 -0300
Subject: [PATCH] sensors: Terminate bounded UDFPS status reads

Reserve one byte for the parser terminator and reject empty/error reads before sscanf. Preserve the existing sensor/provider ABI and supported one-value and coordinate formats.

Validated with 15 production-method host FD cases under ASAN/UBSAN; independently reviewed. No driver or provider change.

Change-Id: I5fc17c28f27bc15cd82433987c0d45ca677a646f
---
 sensors/v2/Sensor.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/sensors/v2/Sensor.cpp b/sensors/v2/Sensor.cpp
index 77577e6..e7aa66d 100644
--- a/sensors/v2/Sensor.cpp
+++ b/sensors/v2/Sensor.cpp
@@ -378,11 +378,13 @@ bool UdfpsSensor::readFd(const int fd) {
         ALOGE("failed to seek: %d", rc);
         return false;
     }
-    rc = read(fd, &buffer, sizeof(buffer));
-    if (rc < 0) {
+    // Leave room for sscanf's terminator, including full or malformed sysfs reads.
+    rc = read(fd, buffer, sizeof(buffer) - 1);
+    if (rc <= 0) {
         ALOGE("failed to read state: %d", rc);
         return false;
     }
+    buffer[rc] = '\0';
     rc = sscanf(buffer, "%d,%d,%d", &mScreenX, &mScreenY, &state);
     if (rc == 1) {
         // If fod_press_status contains only one value,
