# Switch reverse wireless charging through wireless/reverse_chg_mode.
allow hal_lineage_powershare_default sysfs_batteryinfo:dir r_dir_perms;
allow hal_lineage_powershare_default sysfs_batteryinfo:file rw_file_perms;
allow hal_lineage_powershare_default sysfs_batteryinfo:lnk_file read;
