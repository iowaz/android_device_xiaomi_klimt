# Toggle charging through battery/input_suspend.
allow hal_lineage_health_default sysfs_batteryinfo:dir r_dir_perms;
allow hal_lineage_health_default sysfs_batteryinfo:file rw_file_perms;
allow hal_lineage_health_default sysfs_batteryinfo:lnk_file read;
