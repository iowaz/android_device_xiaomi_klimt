android_app {
    name: "KlimtEuiccController",
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    privileged: true,
    required: ["privapp-permissions-klimt-euicc"],
    srcs: ["src/**/*.java"],
    static_libs: ["android.hardware.radio-V1-java"],
    optimize: { enabled: false },
}

prebuilt_etc {
    name: "privapp-permissions-klimt-euicc",
    src: "privapp-permissions-klimt-euicc.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
    filename_from_src: true,
}
