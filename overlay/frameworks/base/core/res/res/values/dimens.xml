<resources>
    <!-- Reproduced from the stock com.mediatek.frameworkresoverlay RRO. -->
    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">0.4</item>
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">1.0</item>
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.00238066</item>

    <!-- Panel geometry from the stock com.miui.systemui.overlay.devices.android
         RRO (product/overlay/DevicesAndroidOverlay.apk). It overrides the
         generic MediaTek values (20dp corners) on stock. -->
    <dimen name="rounded_corner_radius">156px</dimen>
    <dimen name="rounded_corner_radius_top">156px</dimen>
    <dimen name="rounded_corner_radius_bottom">156px</dimen>
    <dimen name="status_bar_height_default">132px</dimen>
    <dimen name="status_bar_height_portrait">132px</dimen>

    <!-- Inset status bar and navigation bar content out of the rounded
         corners. The stock overlay leaves this at 0 because MIUI lays the
         status bar out itself, which clips the clock on the LineageOS one. -->
    <dimen name="rounded_corner_content_padding">12dp</dimen>
</resources>
